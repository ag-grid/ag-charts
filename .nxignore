__diff_output__

# Ignore .rulesync symlinks as nx format doesn't handle these well.
packages/ag-charts-website/src/content/docs/*/_examples/*/benchmarkHarness.ts
packages/ag-charts-website/src/content/docs/*/_examples/*/benchmarkUtils.ts
packages/ag-charts-website/src/content/docs/*/_examples/*/seededRandom.ts
packages/ag-charts-website/src/content/docs/*/_examples/*/randomHelpers.ts
.rulesync/**
!.rulesync/README.md
.patches/
patches/

# Files without Prettier parsers
*.sh
*.patch
.gitrepo
.nxignore
.prettierignore

# Seed projects are not Yarn workspaces (their ag-charts-* pins are for npm; locally they resolve through
# the root node_modules) and not Nx projects of their own: ag-charts-demos-seeds builds and type-checks
# them as one project.
packages/ag-charts-demos/seeds/*/*/package.json
