---
import styles from './TouchDevice.module.scss';
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';

interface Props {
    id: string;
    title: string;
    showHeader?: boolean;
    videoPath?: string;
}

const { title = 'Video', showHeader, videoPath } = Astro.props as Props;
---

<div class={styles.videoSection}>
    <div>
        <div class={styles.deviceContainer}>
            <div class={styles.deviceContent} class:list={{ [styles.videoContent]: showHeader }}><slot /></div>
            <img src={urlWithBaseUrl(videoPath)} class={styles.touchImage} alt={title} />
        </div>
    </div>
</div>
