---
import styles from './TouchDevice.module.scss';
import classNames from 'classnames';
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';

interface Props {
    id: string;
    title: string;
    showHeader?: boolean;
}

const { id, title = 'Video', showHeader } = Astro.props as Props;
---

<div class={styles.videoSection}>
    <div>
        <div class={styles.deviceContainer}>
            <div class={styles.deviceContent} class:list={{ [styles.videoContent]: showHeader }}><slot /></div>
            <img
                src={urlWithBaseUrl('/images/ipad-pro-clay.png')}
                alt={`${title}`}
                class={classNames(styles.ytThumbnail, styles.deviceLight)}
            />
            <img
                src={urlWithBaseUrl('/images/ipad-clay-dark.png')}
                alt={`${title}`}
                class={classNames(styles.ytThumbnail, styles.deviceDark)}
            />
        </div>
    </div>
</div>
