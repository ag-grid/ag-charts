{
    "image": "mcr.microsoft.com/devcontainers/universal:2",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "20"
        }
    },
    "containerEnv": {
        "AG_SKIP_NATIVE_DEP_VERSION_CHECK": "1",
        "PUBLIC_SITE_URL": "https://${CODESPACE_NAME}.app.github.dev/",
        // https://github.com/nrwl/nx/issues/29137
        "NX_PARALLEL": "1",
        // https://github.com/lerna/lerna/issues/4054
        "NX_DAEMON": "true"
    },
    "postCreateCommand": "echo PATH=\"$PATH:/workspaces/ag-charts/node_modules/.bin/\" >>~/.bashrc"
}
