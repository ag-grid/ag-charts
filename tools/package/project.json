{
  "name": "tools-package",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "tools/package",
  "targets": {
    "test": {
      "inputs": [
        "default",
        "buildOutputExcludes",
        "{workspaceRoot}/tools/release/validateDistArtefacts.js",
        "{workspaceRoot}/packages/ag-charts-community/package.json",
        "{workspaceRoot}/packages/ag-charts-enterprise/package.json",
        "{workspaceRoot}/package.json"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test tools/package/*.test.js"
      }
    }
  },
  "tags": ["no-sharding"]
}
