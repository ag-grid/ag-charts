{
    "mcpServers": {
        "fetch": {
            "type": "stdio",
            "command": "yarn",
            "args": ["run", "--silent", "mcp-fetch"],
            "env": {}
        },
        "sequential-thinking": {
            "type": "stdio",
            "command": "yarn",
            "args": ["run", "--silent", "mcp-server-sequential-thinking"],
            "env": {}
        },
        "context7": {
            "type": "stdio",
            "command": "yarn",
            "args": ["run", "--silent", "context7-mcp"],
            "env": {}
        },
        "puppeteer": {
            "type": "stdio",
            "command": "yarn",
            "args": ["run", "--silent", "mcp-server-puppeteer"],
            "env": {}
        },
        "chrome-devtools": {
            "type": "stdio",
            "command": "tools/prompts/nvm-exec.sh",
            "args": ["--silent", "22", "npx", "-y", "--silent", "chrome-devtools-mcp@latest"],
            "env": {}
        }
    },
    "contextFileName": "AGENTS.md"
}
