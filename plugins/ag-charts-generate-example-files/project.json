{
  "name": "ag-charts-generate-example-files",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "plugins/ag-charts-generate-example-files/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:swc",
      "dependsOn": ["ag-charts-community:build:types", "ag-charts-community:build:package", "ag-shared:build"],
      "inputs": ["{projectRoot}/src/**"],
      "outputs": ["{options.outputPath}"],
      "cache": true,
      "options": {
        "outputPath": "{projectRoot}/dist",
        "main": "{projectRoot}/src/index.ts",
        "tsConfig": "{projectRoot}/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default", "buildOutputExcludes"],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "cache": true,
      "options": {
        "command": "npx vitest run --config {projectRoot}/vitest.config.ts"
      },
      "configurations": {
        "update": {
          "args": "--update"
        }
      },
      "dependsOn": ["ag-charts-community:build"]
    }
  },
  "tags": ["plugin"]
}
