{
  "name": "angular-package-tests",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tests/angular-package-tests",
  "projectType": "application",
  "targets": {
    "test:package": {
      "executor": "nx:noop",
      "inputs": [],
      "outputs": [],
      "dependsOn": ["test:package:modules:local-21", "test:package:modules:local-latest", "test:package:production-21"],
      "configurations": {
        "update": {}
      }
    },
    "test:package:local-21": {
      "dependsOn": ["^pack"],
      "command": "{projectRoot}/run.sh 21",
      "configurations": {
        "update": {
          "command": "{projectRoot}/run.sh -u 21"
        }
      }
    },
    "test:package:production-21": {
      "dependsOn": ["^pack"],
      "command": "{projectRoot}/run-modules.sh -p 21",
      "cache": false,
      "configurations": {
        "update": {
          "command": "{projectRoot}/run-modules.sh -p -u 21"
        }
      }
    },
    "test:package:local-latest": {
      "dependsOn": ["^pack"],
      "command": "{projectRoot}/run.sh latest",
      "configurations": {
        "update": {
          "command": "{projectRoot}/run.sh -u latest"
        }
      }
    },
    "test:package:editor": {
      "dependsOn": ["^pack"],
      "command": "{projectRoot}/run.sh -n -e latest"
    },
    "test:package:modules:local-21": {
      "dependsOn": ["^pack"],
      "command": "{projectRoot}/run-modules.sh 21",
      "configurations": {
        "update": {
          "command": "{projectRoot}/run-modules.sh -u 21"
        }
      }
    },
    "test:package:modules:local-latest": {
      "dependsOn": ["^pack"],
      "command": "{projectRoot}/run-modules.sh latest",
      "configurations": {
        "update": {
          "command": "{projectRoot}/run-modules.sh -u latest"
        }
      }
    }
  },
  "implicitDependencies": [
    "ag-charts-core",
    "ag-charts-community",
    "ag-charts-enterprise",
    "ag-charts-locale",
    "ag-charts-types",
    "ag-charts-angular"
  ]
}
