{
  "name": "vue-package-tests",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tests/vue-package-tests",
  "projectType": "application",
  "targets": {
    "test:package": {
      "executor": "nx:noop",
      "inputs": [],
      "outputs": [],
      "dependsOn": ["test:package:modules:local-latest", "test:package:production-latest"],
      "configurations": {
        "update": {}
      }
    },
    "test:package:local-latest": {
      "dependsOn": ["^pack"],
      "command": "{projectRoot}/run.sh latest",
      "configurations": {
        "update": {
          "command": "{projectRoot}/run.sh -u latest"
        }
      }
    },
    "test:package:production-latest": {
      "dependsOn": ["^pack"],
      "command": "{projectRoot}/run.sh -p latest",
      "cache": false,
      "configurations": {
        "update": {
          "command": "{projectRoot}/run.sh -p -u latest"
        }
      }
    },
    "test:package:editor": {
      "dependsOn": ["^pack"],
      "command": "{projectRoot}/run.sh -n -e latest"
    },
    "test:package:modules:local-latest": {
      "dependsOn": ["^pack"],
      "command": "{projectRoot}/run-modules.sh latest",
      "configurations": {
        "update": {
          "command": "{projectRoot}/run-modules.sh -u latest"
        }
      }
    }
  },
  "implicitDependencies": [
    "ag-charts-core",
    "ag-charts-community",
    "ag-charts-enterprise",
    "ag-charts-locale",
    "ag-charts-types",
    "ag-charts-vue3"
  ]
}
