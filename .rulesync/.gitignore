# AG-17085 Phase 3 — content staged by external/ag-shared/scripts/rulesync-fetch/.
# Patterns cover everything delivered via ag-dev-prompts plugins; local-only
# items (skills, commands, rules) remain tracked via allowlist entries.

.fetched-from-ag-dev-prompts
mcp.json

# Plugin-delivered skills — allowlist local-only skills
/skills/*
!/skills/animation-test-migration/
!/skills/technology-stack/

# Plugin-delivered agents — all agents live in plugins
/subagents/*.md

# Plugin-delivered commands — all commands live in plugins
/commands/*.md
/commands/docs/

# Plugin-delivered rules — allowlist local-only rules (chart-source-coupled)
/rules/*.md
!/rules/ag-charts.md
!/rules/animation-trajectory-tests.md
!/rules/api-contracts.md
!/rules/cartesian-series-types.md
!/rules/data-model.md
!/rules/defaults.md
!/rules/dom-performance.md
!/rules/entry-point-hygiene.md
!/rules/module-support.md
!/rules/numeric-values.md
!/rules/series.md
!/rules/test-harness-contracts.md
!/rules/website-e2e-testing.md
!/rules/server-side-rendering.md
