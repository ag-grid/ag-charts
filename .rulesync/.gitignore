# AG-17085 Phase 3 — content staged by external/ag-shared/scripts/rulesync-fetch/.
# Patterns cover everything delivered via ag-dev-prompts plugins; local-only
# items (skills, commands, rules) remain tracked via allowlist entries.

.fetched-from-ag-dev-prompts
mcp.json

# Plugin-delivered skills — allowlist local-only skills
/skills/*
!/skills/releases/
!/skills/technology-stack/
!/skills/triage-rt/
!/skills/triage-rt-board/
!/skills/writing-style/

# Plugin-delivered agents — all agents live in plugins
/subagents/*.md

# Plugin-delivered commands — allowlist local-only commands
/commands/*.md
!/commands/release-summary.md
/commands/docs/

# Plugin-delivered rules — enumerate fetched entries
/rules/browser-support.md
/rules/code-quality.md
/rules/nx-conventions.md
/rules/rulesync-editing.md
/rules/setup-prompts.md
/rules/website-astro-pages.md
/rules/website-browser-testing.md
/rules/website-css.md
