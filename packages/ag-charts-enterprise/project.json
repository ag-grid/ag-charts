{
  "name": "ag-charts-enterprise",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:noop",
      "dependsOn": ["build:types", "build:package", "build:umd"],
      "inputs": [],
      "outputs": [],
      "configurations": {
        "watch": {},
        "production": {}
      }
    },
    "build:types": {
      "options": {
        "additionalEntryPoints": []
      }
    },
    "build:test": {},
    "build:package": {
      "options": {
        "additionalEntryPoints": [],
        "external": ["ag-charts-core", "ag-charts-community"]
      }
    },
    "build:umd": {
      "options": {
        "outputFileName": "ag-charts-enterprise",
        "main": "{projectRoot}/src/main-umd.ts"
      }
    },
    "lint:eslint": {},
    "lint:circular": {},
    "lint:depcruise": {},
    "lint:change-detection": {},

    "lint": {
      "executor": "nx:noop",
      "dependsOn": ["lint:eslint", "lint:circular", "lint:depcruise", "lint:change-detection"],
      "configurations": {
        "fix": {}
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default", "buildOutputExcludes", "^production", "{workspaceRoot}/jest.preset.js"],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}", "{workspaceRoot}/reports/ag-charts-enterprise.xml"],
      "cache": true,
      "parallelism": false,
      "options": {
        "commands": [
          "node --expose-gc ./node_modules/jest/bin/jest.js --config {projectRoot}/jest.config.ts --testPathIgnorePatterns='benchmarks/.*'"
        ]
      },
      "configurations": {
        "ci": {
          "commands": [
            "node --expose-gc ./node_modules/jest/bin/jest.js --config {projectRoot}/jest.config.ts  --testPathIgnorePatterns='benchmarks/.*' -u"
          ]
        },
        "watch": {
          "commands": [
            "node --expose-gc ./node_modules/jest/bin/jest.js --config {projectRoot}/jest.config.ts  --testPathIgnorePatterns='benchmarks/.*' --watch"
          ]
        },
        "update": {
          "commands": [
            "node --expose-gc ./node_modules/jest/bin/jest.js --config {projectRoot}/jest.config.ts  --testPathIgnorePatterns='benchmarks/.*' -u"
          ]
        }
      },
      "dependsOn": [
        "build:test",
        {
          "projects": ["ag-charts-community-examples"],
          "target": "build"
        }
      ]
    },
    "benchmark": {
      "dependsOn": [
        "build",
        {
          "projects": ["ag-charts-community-examples"],
          "target": "build"
        },
        "ag-charts-website-benchmarks_enterprise-1M-line-series_main.ts:generate-example",
        "ag-charts-website-benchmarks_axes-1M-time_main.ts:generate-example",
        "ag-charts-website-benchmarks_axes-1M-unit-time_main.ts:generate-example",
        "ag-charts-website-benchmarks_axes-1M-ordinal-time_main.ts:generate-example",
        "ag-charts-website-benchmarks_axes-1M-number_main.ts:generate-example",
        "ag-charts-website-benchmarks_high-perf-area_main.ts:generate-example",
        "ag-charts-website-benchmarks_high-perf-area-stacked_main.ts:generate-example",
        "ag-charts-website-benchmarks_high-perf-bar_main.ts:generate-example",
        "ag-charts-website-benchmarks_high-perf-bar-stacked_main.ts:generate-example",
        "ag-charts-website-benchmarks_high-perf-line_main.ts:generate-example",
        "ag-charts-website-benchmarks_high-perf-ohlc_main.ts:generate-example",
        "ag-charts-website-benchmarks_high-perf-range-area_main.ts:generate-example",
        "ag-charts-website-benchmarks_high-perf-range-bar_main.ts:generate-example",
        "ag-charts-website-benchmarks_high-freq-candlestick_main.ts:generate-example"
      ]
    },
    "pack": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": ["allTransitiveOutputs"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}.tgz"],
      "options": {
        "cwd": "{projectRoot}",
        "parallel": false,
        "commands": ["mkdir -p ../../dist/packages", "yarn pack -f ../../dist/packages/ag-charts-enterprise.tgz"]
      }
    },
    "pack:extract": {
      "executor": "nx:run-commands",
      "dependsOn": ["pack"],
      "inputs": ["allOutputs"],
      "outputs": ["{workspaceRoot}/dist/packages/contents/ag-charts-enterprise/"],
      "options": { "command": "tools/package/extract-contents.sh {projectRoot}" }
    },
    "pack:verify": {
      "executor": "nx:run-commands",
      "dependsOn": ["pack:extract"],
      "inputs": ["allOutputs"],
      "options": {
        "commands": ["node tools/package/sanity-check-package.js dist/packages/contents/ag-charts-enterprise/package"]
      }
    },
    "test:validate-size": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "size-limit"
      }
    }
  },
  "tags": ["package"],
  "implicitDependencies": [
    "ag-charts-community",
    "ag-charts-test",
    "ag-charts-locale",
    "ag-charts-types",
    "ag-charts-core"
  ]
}
