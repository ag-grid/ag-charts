{
  "name": "ag-charts-react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ag-charts-react/src",
  "projectType": "library",
  "tags": ["fw"],
  "targets": {
    "lint": {
      "executor": "nx:noop",
      "dependsOn": ["lint:eslint"],
      "configurations": {
        "fix": {}
      }
    },
    "lint:eslint": {},
    "build": {
      "executor": "nx:noop",
      "dependsOn": ["build:package", "build:umd", "build:types"],
      "inputs": [],
      "outputs": [],
      "configurations": {
        "watch": {},
        "production": {}
      }
    },
    "build:types": {
      "options": {
        "main": "{projectRoot}/src/index.ts"
      }
    },
    "build:package": {
      "dependsOn": ["^build:types", "^build:package"],
      "options": {
        "main": "{projectRoot}/src/index.ts",
        "external": ["ag-charts-community", "react", "react-dom", "react/jsx-runtime"]
      }
    },
    "build:umd": {
      "options": {
        "outputFileName": "ag-charts-react",
        "main": "{projectRoot}/dist/package/index.esm.mjs",
        "external": ["ag-charts-community", "react", "react-dom"]
      }
    },
    "pack": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": ["allTransitiveOutputs", "{projectRoot}/.npmignore"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}.tgz"],
      "options": {
        "cwd": "{projectRoot}",
        "parallel": false,
        "commands": ["mkdir -p ../../dist/packages", "yarn pack -o ../../dist/packages/ag-charts-react.tgz"]
      }
    },
    "pack:extract": {
      "executor": "nx:run-commands",
      "dependsOn": ["pack"],
      "inputs": ["allOutputs"],
      "outputs": ["{workspaceRoot}/dist/packages/contents/ag-charts-react/"],
      "options": { "command": "tools/package/extract-contents.sh {projectRoot}" }
    },
    "pack:verify": {
      "executor": "nx:run-commands",
      "dependsOn": ["pack:extract"],
      "inputs": ["allOutputs"],
      "options": {
        "commands": ["node tools/package/sanity-check-package.js dist/packages/contents/ag-charts-react/package"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["ag-charts-core", "ag-charts-test"],
          "target": "build"
        }
      ],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/packages/ag-charts-enterprise/src/**/*",
        "{workspaceRoot}/packages/ag-charts-enterprise/vitest.setup.ts"
      ],
      "outputs": ["{workspaceRoot}/reports/ag-charts-react.xml"],
      "cache": true,
      "options": {
        "command": "npx vitest run --config {projectRoot}/vitest.config.ts"
      },
      "configurations": {
        "ci": {},
        "watch": {
          "command": "npx vitest --config {projectRoot}/vitest.config.ts"
        }
      }
    }
  },
  "implicitDependencies": ["ag-charts-community"]
}
