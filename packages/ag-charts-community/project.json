{
  "name": "ag-charts-community",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:noop",
      "dependsOn": ["build:types", "build:package", "build:umd"],
      "inputs": [],
      "outputs": [],
      "configurations": {
        "watch": {},
        "production": {}
      }
    },
    "build:types": {
      "options": {
        "additionalEntryPoints": ["{projectRoot}/src/integrated-charts-scene.ts"]
      }
    },
    "build:test": {},
    "build:package": {
      "options": {
        "additionalEntryPoints": ["{projectRoot}/src/integrated-charts-scene.ts"],
        "external": ["ag-charts-core"]
      }
    },
    "build:umd": {
      "dependsOn": [],
      "inputs": ["production", "^production"],
      "options": {
        "outputFileName": "ag-charts-community",
        "main": "{projectRoot}/src/main-umd.ts"
      }
    },
    "lint:eslint": {},
    "lint:circular": {},
    "lint:depcruise": {},
    "lint:change-detection": {},
    "lint": {
      "executor": "nx:noop",
      "dependsOn": ["lint:eslint", "lint:circular", "lint:depcruise", "lint:change-detection"],
      "configurations": {
        "fix": {}
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default", "buildOutputExcludes", "^production"],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}", "{workspaceRoot}/reports/ag-charts-community.xml"],
      "cache": true,
      "options": {
        "command": "npx vitest run --config {projectRoot}/vitest.config.ts"
      },
      "parallelism": false,
      "configurations": {
        "ci": {
          "args": "--update"
        },
        "watch": {
          "command": "npx vitest --config {projectRoot}/vitest.config.ts"
        },
        "update": {
          "args": "--update"
        }
      },
      "dependsOn": [
        "build:test",
        {
          "projects": ["ag-charts-community-examples"],
          "target": "build"
        },
        {
          "projects": ["ag-charts-types"],
          "target": "docs-resolved-interfaces"
        }
      ]
    },
    "pack": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": ["allTransitiveOutputs", "{projectRoot}/.npmignore"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}.tgz"],
      "options": {
        "cwd": "{projectRoot}",
        "parallel": false,
        "commands": ["mkdir -p ../../dist/packages", "yarn pack -f ../../dist/packages/ag-charts-community.tgz"]
      }
    },
    "pack:extract": {
      "executor": "nx:run-commands",
      "dependsOn": ["pack"],
      "inputs": ["allOutputs"],
      "outputs": ["{workspaceRoot}/dist/packages/contents/ag-charts-community/"],
      "options": {
        "command": "tools/package/extract-contents.sh {projectRoot}"
      }
    },
    "pack:verify": {
      "executor": "nx:run-commands",
      "dependsOn": ["pack:extract"],
      "inputs": ["allOutputs"],
      "options": {
        "commands": ["node tools/package/sanity-check-package.js dist/packages/contents/ag-charts-community/package"]
      }
    },
    "test:validate-size": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "size-limit"
      }
    }
  },
  "implicitDependencies": ["ag-charts-test", "ag-charts-locale", "ag-charts-types", "ag-charts-core"],
  "tags": ["package"]
}
