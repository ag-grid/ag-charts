{
  "name": "ag-charts-community",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:noop",
      "dependsOn": ["build:types", "build:package", "build:umd"],
      "inputs": [],
      "outputs": [],
      "configurations": {
        "watch": {},
        "production": {}
      }
    },
    "build:types": {
      "options": {
        "additionalEntryPoints": ["{projectRoot}/src/integrated-charts-scene.ts"]
      }
    },
    "build:test": {},
    "build:package": {
      "options": {
        "additionalEntryPoints": ["{projectRoot}/src/integrated-charts-scene.ts"],
        "external": ["ag-charts-core"]
      }
    },
    "build:umd": {
      "options": {
        "outputFileName": "ag-charts-community",
        "main": "{projectRoot}/src/main-umd.ts"
      }
    },
    "lint:eslint": {},
    "lint:circular": {},
    "lint:depcruise": {},
    "lint:change-detection": {},
    "lint": {
      "executor": "nx:noop",
      "dependsOn": ["lint:eslint", "lint:circular", "lint:depcruise", "lint:change-detection"],
      "configurations": {
        "fix": {}
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default", "buildOutputExcludes", "^production", "{workspaceRoot}/jest.preset.js"],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}", "{workspaceRoot}/reports/ag-charts-community.xml"],
      "cache": true,
      "parallelism": false,
      "options": {
        "commands": [
          "node --expose-gc ./node_modules/jest/bin/jest.js --config {projectRoot}/jest.config.ts --testPathIgnorePatterns='benchmarks/.*'"
        ]
      },
      "configurations": {
        "ci": {
          "commands": [
            "node --expose-gc ./node_modules/jest/bin/jest.js --config {projectRoot}/jest.config.ts  --testPathIgnorePatterns='benchmarks/.*' -u"
          ]
        },
        "watch": {
          "commands": [
            "node --expose-gc ./node_modules/jest/bin/jest.js --config {projectRoot}/jest.config.ts  --testPathIgnorePatterns='benchmarks/.*' --watch"
          ]
        },
        "update": {
          "commands": [
            "node --expose-gc ./node_modules/jest/bin/jest.js --config {projectRoot}/jest.config.ts  --testPathIgnorePatterns='benchmarks/.*' -u"
          ]
        }
      },
      "dependsOn": [
        "build:test",
        {
          "projects": ["ag-charts-community-examples"],
          "target": "build"
        }
      ]
    },
    "benchmark": {
      "dependsOn": [
        "build",
        "ag-charts-website-benchmarks_simple-sparkline_main.ts:generate-example",
        "ag-charts-website-benchmarks_simple-chart_main.ts:generate-example",
        "ag-charts-website-benchmarks_integrated-large-scale_main.ts:generate-example",
        "ag-charts-website-benchmarks_large-dataset_main.ts:generate-example",
        "ag-charts-website-benchmarks_large-scale-multi-series_main.ts:generate-example",
        "ag-charts-website-benchmarks_multi-series_main.ts:generate-example",
        "ag-charts-website-benchmarks_resize_main.ts:generate-example",
        "ag-charts-website-benchmarks_high-freq-line_main.ts:generate-example",
        "ag-charts-website-benchmarks_high-freq-bar_main.ts:generate-example",
        "ag-charts-website-benchmarks_high-freq-area_main.ts:generate-example"
      ]
    },
    "pack": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": ["allTransitiveOutputs", "{projectRoot}/.npmignore"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}.tgz"],
      "options": {
        "cwd": "{projectRoot}",
        "parallel": false,
        "commands": ["mkdir -p ../../dist/packages", "yarn pack -f ../../dist/packages/ag-charts-community.tgz"]
      }
    },
    "pack:extract": {
      "executor": "nx:run-commands",
      "dependsOn": ["pack"],
      "inputs": ["allOutputs"],
      "outputs": ["{workspaceRoot}/dist/packages/contents/ag-charts-community/"],
      "options": { "command": "tools/package/extract-contents.sh {projectRoot}" }
    },
    "pack:verify": {
      "executor": "nx:run-commands",
      "dependsOn": ["pack:extract"],
      "inputs": ["allOutputs"],
      "options": {
        "commands": ["node tools/package/sanity-check-package.js dist/packages/contents/ag-charts-community/package"]
      }
    },
    "test:validate-size": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "size-limit"
      }
    }
  },
  "implicitDependencies": ["ag-charts-test", "ag-charts-locale", "ag-charts-types", "ag-charts-core"],
  "tags": ["package"]
}
