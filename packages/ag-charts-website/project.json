{
  "name": "ag-charts-website",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/ag-charts-website/src",
  "targets": {
    "build": {
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "dependsOn": ["^build", "^docs-resolved-interfaces", "generate-examples", "generate-thumbnails"],
      "inputs": [
        "^production",
        "production",
        "!{projectRoot}/vitest.config.mjs",
        "{workspaceRoot}/external/ag-website-shared/**",
        {
          "externalDependencies": ["npm:astro"]
        },
        {
          "env": "PUBLIC_PACKAGE_VERSION"
        }
      ],
      "cache": false,
      "command": "astro build",
      "options": {
        "cwd": "packages/ag-charts-website",
        "silent": true
      },
      "configurations": {
        "staging": {},
        "archive": {},
        "production": {}
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "^docs-resolved-interfaces"],
      "inputs": [],
      "outputs": [],
      "options": {
        "cwd": "packages/ag-charts-website",
        "parallel": false,
        "commands": ["rm -rf node_modules/.vite/", "astro dev --port=${PORT} --host"]
      },
      "configurations": {
        "watch": {}
      }
    },
    "preview": {
      "dependsOn": ["build"],
      "command": "astro preview --port=${PORT}",
      "options": {
        "cwd": "packages/ag-charts-website"
      },
      "configurations": {
        "staging": {},
        "archive": {},
        "production": {}
      }
    },
    "lint:eslint": {},
    "lint": {
      "executor": "nx:noop",
      "dependsOn": ["lint:eslint", "format:mdoc:check"],
      "configurations": {
        "fix": {}
      }
    },
    "format:mdoc": {
      "command": "tsx scripts/format-mdoc-codeblocks.ts --write",
      "options": {
        "cwd": "packages/ag-charts-website"
      },
      "inputs": ["{projectRoot}/src/**/*.mdoc"],
      "outputs": []
    },
    "format:mdoc:check": {
      "command": "tsx scripts/format-mdoc-codeblocks.ts --check || echo \"Run this command to fix formatting errors:\\nnx format:mdoc ag-charts-website\"",
      "options": {
        "cwd": "packages/ag-charts-website"
      },
      "inputs": ["{projectRoot}/src/**/*.mdoc"],
      "outputs": []
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": ["test:vitest"],
      "inputs": [],
      "outputs": [],
      "configurations": {
        "ci": {},
        "watch": {},
        "update": {}
      }
    },
    "test:vitest": {
      "command": "npx vitest",
      "outputs": ["{workspaceRoot}/reports/ag-charts-website.xml"],
      "dependsOn": [],
      "options": {
        "config": "{projectRoot}/vitest.config.mjs",
        "watch": false
      },
      "configurations": {
        "ci": {
          "outputFile": "../../reports/ag-charts-website.xml",
          "update": true,
          "reporters": ["junit"]
        },
        "watch": {
          "watch": true
        },
        "update": {
          "update": true
        }
      }
    },
    "test:e2e": {
      "dependsOn": ["^build", "generate-examples"],
      "inputs": ["{projectRoot}/playwright.config.ts", "{projectRoot}/e2e/**", { "env": "NX_BASE" }],
      "outputs": [],
      "command": "./playwright.sh --host test",
      "cache": false,
      "parallelism": false,
      "options": {
        "cwd": "packages/ag-charts-website"
      },
      "configurations": {
        "update": {
          "command": "./playwright.sh --host test -u $(grep -lR 'toHaveScreenshot' e2e)"
        },
        "without-snapshots": {
          "command": "./playwright.sh --host test $(grep -LR 'toHaveScreenshot' e2e)"
        },
        "ui": {
          "command": "./playwright.sh --host test --ui-port=8080 --ui-host=0.0.0.0"
        }
      }
    },
    "generate-examples": {
      "executor": "nx:noop",
      "dependsOn": ["^generate-example"],
      "inputs": [],
      "outputs": [],
      "cache": true,
      "configurations": {
        "archive": {},
        "staging": {},
        "production": {}
      }
    },
    "generate-thumbnails": {
      "executor": "nx:noop",
      "dependsOn": ["^generate-thumbnail"],
      "inputs": [],
      "outputs": [],
      "cache": true,
      "configurations": {
        "archive": {},
        "staging": {},
        "production": {}
      }
    },
    "validate-examples": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build:types"],
      "inputs": [
        "{projectRoot}/tsconfig.examples.json",
        "{workspaceRoot}/packages/ag-charts-website/src/**/_examples/**/*.ts",
        "tsDeclarations"
      ],
      "outputs": [],
      "cache": true,
      "options": {
        "commands": ["npx tsc -p {projectRoot}/tsconfig.examples.json"]
      }
    },
    "update-algolia": {
      "command": "node update-algolia.js -d --local",
      "options": {
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "staging": {
          "command": "node update-algolia.js -i ag-charts-dev"
        },
        "archive": {
          "command": "node update-algolia.js -i ag-charts-dev"
        },
        "production": {
          "command": "node update-algolia.js -i ag-charts"
        }
      }
    },
    "update-versions-data": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx {projectRoot}/scripts/versions-data/updateVersionsData.ts"
      },
      "configurations": {
        "verbose": {
          "args": ["--verbose"]
        }
      }
    }
  },
  "implicitDependencies": [
    "ag-charts-locale",
    "ag-charts-types",
    "ag-charts-community",
    "ag-charts-enterprise",
    "ag-charts-angular",
    "ag-charts-react",
    "ag-charts-vue3"
  ],
  "tags": ["skip-gha-cache"]
}
