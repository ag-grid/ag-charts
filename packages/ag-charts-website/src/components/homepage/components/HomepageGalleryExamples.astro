---
import { getCacheBustingUrl, getChartEnterpriseScriptPath } from '@utils/chartLibraryPaths';
import { SITE_BASE_URL } from '@constants';
import { pathJoin } from '@utils/pathJoin';
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';
import styles from './HomepageGalleryExamples.module.scss';
import { getEntry, type CollectionEntry } from 'astro:content';
import { getGalleryExamplesData } from '@components/homepage/components/gallery-examples/galleryExamplesData';
import { GLOBAL_HOMEPAGE_EXAMPLES_VARIABLE, GLOBAL_UPDATE_FUNCTION_NAME } from '@components/homepage/constants';
import { Icon, type IconName } from '@ag-website-shared/components/icon/Icon';
import AgLoadingLogo from '@ag-website-shared/images/inline-svgs/ag-grid-logomark-loading.svg?react';

const siteUrl = Astro.site ? pathJoin(Astro.site, SITE_BASE_URL) : '/';
const timeNow = Date.now();
const chartScriptEnterprisePath = getCacheBustingUrl(getChartEnterpriseScriptPath(siteUrl), timeNow);

const { data: galleryData } = (await getEntry('homepageGallery', 'examples')) as CollectionEntry<'homepageGallery'>;
const { data: allGalleryData } = (await getEntry('gallery', 'data')) as CollectionEntry<'gallery'>;
const galleryExamplesData = await getGalleryExamplesData({
    galleryData,
    allGalleryData,
});

const initialExampleId = 'bar';
const loadingId = 'homepageGalleryLoading';
---

<script src={chartScriptEnterprisePath}></script>
<script src={urlWithBaseUrl('/homepage/examples.js')} type="module"></script>

<div class={styles.container}>
    <div class={styles.tabContainer}>
        {
            Object.keys(galleryExamplesData).map((id) => {
                const example = galleryExamplesData[id];
                return (
                    <button class={styles.tabButton} data-example-id={id}>
                        <Icon svgClasses={styles.tabButtonIcon} name={example.icon as IconName} />
                        {example.buttonText}
                    </button>
                );
            })
        }
    </div>
    <div class={styles.exampleContainer}>
        <div id="myChart"></div>
        <div id={loadingId}>
            <AgLoadingLogo />
        </div>
    </div>
</div>

<script
    define:vars={{
        initialExampleId,
        buttonsClass: styles.tabButton,
        activeButtonClass: styles.activeTabButton,
        GLOBAL_HOMEPAGE_EXAMPLES_VARIABLE,
        GLOBAL_UPDATE_FUNCTION_NAME,
        loadingId,
    }}
>
    let chartInstance;
    let hasLoaded = false;
    const buttons = document.querySelectorAll(`.${buttonsClass}`);
    function updateActiveButton(button) {
        buttons.forEach((btn) => btn.classList.remove(activeButtonClass));
        button.classList.add(activeButtonClass);
    }

    function removeLoading() {
        const loadingElement = document.getElementById(loadingId);
        if (loadingElement) {
            loadingElement.remove();
        }
    }

    function updateExample(exampleId) {
        const button = document.querySelector(`.${buttonsClass}[data-example-id="${exampleId}"]`);
        updateActiveButton(button);

        const exampleData = window[GLOBAL_HOMEPAGE_EXAMPLES_VARIABLE][exampleId];
        exampleData.updateExample();
    }

    function isGaugeExample(exampleId) {
        return exampleId.endsWith('-gauge');
    }

    function destroyChartInstance() {
        if (chartInstance) {
            chartInstance.destroy();
            chartInstance = null;
        }
    }

    function createChartInstance({ options, isGauge }) {
        const createMethod = isGauge ? 'createGauge' : 'create';
        chartInstance = agCharts.AgCharts[createMethod](options);

        if (!hasLoaded) {
            chartInstance.waitForUpdate().then(() => {
                hasLoaded = true;
                removeLoading();
            });
        }
    }

    function updateChartInstance({ options }) {
        chartInstance.update(options);
    }

    function updateChart({ shouldDestroy, isGauge, options }) {
        if (!chartInstance) {
            createChartInstance({ options, isGauge });
            return;
        }

        if (shouldDestroy) {
            destroyChartInstance();
            createChartInstance({ options, isGauge });
        } else {
            updateChartInstance({ options });
        }
    }

    function init() {
        let prevExampleId = initialExampleId;
        let currentExampleId = initialExampleId;

        window[GLOBAL_UPDATE_FUNCTION_NAME] = (options) => {
            const prevIsGauge = isGaugeExample(prevExampleId);
            const curIsGauge = isGaugeExample(currentExampleId);
            const shouldDestroy = prevIsGauge !== curIsGauge;

            updateChart({
                shouldDestroy,
                isGauge: curIsGauge,
                options,
            });
        };

        buttons.forEach((button) => {
            const { exampleId } = button.dataset;

            button.addEventListener('click', () => {
                prevExampleId = currentExampleId;
                currentExampleId = exampleId;

                updateExample(exampleId);
            });

            if (initialExampleId === exampleId) {
                updateExample(exampleId);
            }
        });
    }

    // Initialise once DOM is ready
    document.addEventListener('DOMContentLoaded', () => {
        init();
    });
</script>
