---
// cspell:ignore vars
import { getCacheBustingUrl, getChartEnterpriseScriptPath } from '@utils/chartLibraryPaths';
import { getIsDev } from '@utils/env';
import { SITE_BASE_URL } from '@constants';
import { pathJoin } from '@utils/pathJoin';
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';
import styles from './HomepageGalleryExamples.module.scss';
import { getEntry, type CollectionEntry } from 'astro:content';
import { getGalleryExamplesData } from '@components/homepage/components/gallery-examples/galleryExamplesData';
import {
    GLOBAL_UPDATE_EXAMPLES_VARIABLE,
    GLOBAL_UPDATE_FUNCTION_NAME,
    HOMEPAGE_GALLERY_PANEL_ID,
    HOMEPAGE_GALLERY_SELECT_EVENT,
    HOMEPAGE_GALLERY_TABLIST_ID,
    getHomepageGalleryTabId,
} from '@components/homepage/constants';
import type { IconName } from '@ag-website-shared/components/icon/Icon';
import { HomepageGalleryTabs } from './HomepageGalleryTabs';
import AgLoadingLogo from '@ag-website-shared/images/inline-svgs/ag-grid-logomark-loading.svg?react';

const siteUrl = Astro.site ? pathJoin(Astro.site, SITE_BASE_URL) : '/';
const timeNow = Date.now();
const chartScriptEnterprisePath = getCacheBustingUrl(getChartEnterpriseScriptPath(siteUrl), timeNow);

const { data: galleryData } = (await getEntry('homepageGallery', 'examples')) as CollectionEntry<'homepageGallery'>;
const { data: allGalleryData } = (await getEntry('gallery', 'data')) as CollectionEntry<'gallery'>;
const galleryExamplesData = await getGalleryExamplesData({
    galleryData,
    allGalleryData,
});

const initialExampleId = 'bar';
const loadingId = 'homepageGalleryLoading';
const tabExamples = Object.entries(galleryExamplesData).map(([id, { buttonText, icon }]) => ({
    id,
    buttonText,
    icon: icon as IconName,
}));
const examplesUrl = getIsDev() ? urlWithBaseUrl('/homepage/examples.js') : urlWithBaseUrl('/homepage/examples.min.js');
---

{/* is:inline: Astro 7's compiler processes a script whose only attribute is `src`, dropping the dynamic URL. */}
<script is:inline src={chartScriptEnterprisePath}></script>
<script src={examplesUrl} type="module"></script>

<div class={styles.container}>
    <HomepageGalleryTabs client:load examples={tabExamples} initialExampleId={initialExampleId} />
    <div
        class={styles.exampleContainer}
        id={HOMEPAGE_GALLERY_PANEL_ID}
        role="tabpanel"
        aria-labelledby={getHomepageGalleryTabId(initialExampleId)}
    >
        <div id="myChart"></div>
        <div id={loadingId}>
            <AgLoadingLogo />
        </div>
    </div>
</div>

{/* External so the site CSP covers it without a hash. Must stay non-deferred so it runs after
    the AgCharts UMD above. */}
<script
    is:inline
    src={urlWithBaseUrl('/scripts/homepage-gallery.js')}
    data-tablist-id={HOMEPAGE_GALLERY_TABLIST_ID}
    data-select-event={HOMEPAGE_GALLERY_SELECT_EVENT}
    data-update-examples-var={GLOBAL_UPDATE_EXAMPLES_VARIABLE}
    data-update-fn-name={GLOBAL_UPDATE_FUNCTION_NAME}
    data-loading-id={loadingId}
></script>
