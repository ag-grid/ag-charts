---
/**
 * Server-rendered links between the `/options/` reference pages, for crawlers that don't execute
 * JavaScript. Replaced, along with the rest of the fallback, by the interactive navigation tree once
 * the React reference island mounts.
 */
import { getOptionsStaticPaths } from '@components/api-documentation/apiReferenceHelpers';
import { apiReferencePageHeading } from '@utils/markdown-pages/apiReferencePageContent';
import { getInterfacesReference } from '@utils/server/getInterfacesReference';
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';
import styles from './ApiReferenceFallback.module.scss';

const rootHref = urlWithBaseUrl('/options/');

// One group per union member with a page per variant, e.g. `series` → `series[type='bar']`, ...
const groups = new Map<string, { href: string; label: string }[]>();
for (const { params, props } of getOptionsStaticPaths(getInterfacesReference())) {
    const groupName = props.pageTitle.name;
    let links = groups.get(groupName);
    if (links == null) {
        links = [];
        groups.set(groupName, links);
    }
    links.push({
        href: urlWithBaseUrl(`/options/${params.memberName}/${params.type}/`),
        label: apiReferencePageHeading(props.pageTitle),
    });
}

const normalisePath = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const currentPath = normalisePath(Astro.url.pathname);
const ariaCurrent = (href: string) => (normalisePath(href) === currentPath ? 'page' : undefined);
---

<nav class={styles.referenceNav} aria-label="Options API reference">
    <a href={rootHref} aria-current={ariaCurrent(rootHref)}>
        options
    </a>
    <ul>
        {[...groups].map(([groupName, links]) => (
            <li>
                <span class={styles.referenceNavGroup}>{groupName}</span>
                <ul>
                    {links.map(({ href, label }) => (
                        <li>
                            <a href={href} aria-current={ariaCurrent(href)}>
                                {label}
                            </a>
                        </li>
                    ))}
                </ul>
            </li>
        ))}
    </ul>
</nav>
