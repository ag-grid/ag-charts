---
/**
 * Server-rendered list of an interface's members, for crawlers that don't execute JavaScript.
 * Replaced once the React reference island mounts. Only the members the navigation links to are
 * listed beneath the top level, to keep the served HTML small.
 */
import type { FallbackNavItem } from '@components/api-documentation/apiReferenceFallbackNav';
import type { MemberNode } from '@generate-code-reference-plugin/doc-interfaces/types';
import ApiReferenceFallbackRow from './ApiReferenceFallbackRow.astro';
import styles from './ApiReferenceFallback.module.scss';

interface Props {
    /** Interface name, as the anchor prefix the hydrated rows use. */
    id: string;
    members: MemberNode[];
    hideRequired?: boolean;
    /** Navigation entries for the members, which the properties nested beneath each are taken from. */
    anchors?: FallbackNavItem[];
}

const { id, members, hideRequired, anchors = [] } = Astro.props;
---

<dl class={styles.referenceList}>
    {members.map((member) => (
        <ApiReferenceFallbackRow
            id={`reference-${id}-${member.name}`}
            member={member}
            hideRequired={hideRequired}
            anchors={anchors.find((anchor) => anchor.member?.name === member.name)?.children}
        />
    ))}
</dl>
