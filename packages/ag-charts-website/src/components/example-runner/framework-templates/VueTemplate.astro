---
import CleanCSS from 'clean-css';

import type { Library } from '@ag-grid-types';
import { MetaData } from './lib/MetaData';
import { Scripts } from './lib/Scripts';
import { Styles } from './lib/Styles';
import { SystemJs } from './lib/SystemJs';
import { pathJoin } from '@utils/pathJoin';
import { getCacheBustingUrl } from '@utils/chartLibraryPaths';

interface Props {
    isDev: boolean;
    title: string;

    modifiedTimeMs: number;
    entryFileName: string;

    /**
     * Extra script file names (not including entry file)
     */
    scriptFiles?: string[];
    styleFiles?: string[];
    appLocation: string;
    boilerplatePath: string;
    children?: any;
    headFragment?: string;
}

const {
    isDev,
    title,
    modifiedTimeMs,
    boilerplatePath,
    appLocation,
    entryFileName,
    scriptFiles = [],
    styleFiles = [],
    headFragment,
} = Astro.props as Props;

const startFile = pathJoin(appLocation, entryFileName);

import exampleControlsStyles from '@ag-website-shared/components/example-runner/example-controls.css?raw';

const frameworkStyles = `
    #app {
        display: flex;
        flex-direction: column;
        height: 100%;
        gap: 8px;
    }

    #app div:has(> .ag-charts-wrapper) {
        padding: 1rem;
        height: 100%;
        border-radius: 8px;
        background-color: var(--chart-bg);
        border: 1px solid var(--chart-border);
        overflow: hidden;
    }
`;

const cssMinifier = new CleanCSS({ format: { wrapAt: 120 } });
const minGenericExampleStyles = cssMinifier.minify(exampleControlsStyles.concat(frameworkStyles)).styles;
---

<html lang="en">
    <head>
        <MetaData isDev={isDev} title={`Vue 3 Example - ${title}`} modifiedTimeMs={modifiedTimeMs} />

        <!-- Generic example styles must be first <style> tag in head, to skip prettier formatting in the middleware -->
        <style set:html={minGenericExampleStyles}></style>

        <Styles
            baseUrl={appLocation}
            files={isDev ? styleFiles.map((file: string) => getCacheBustingUrl(file, modifiedTimeMs)) : styleFiles}
        />
        <Fragment set:html={headFragment} />
    </head>
    <body>
        <div id="app"><my-component></my-component></div>

        <Scripts baseUrl={appLocation} files={scriptFiles} />
        <SystemJs
            isDev={isDev}
            boilerplatePath={boilerplatePath}
            appLocation={appLocation}
            startFile={startFile}
            internalFramework="vue3"
        />
        <slot />
    </body>
</html>
