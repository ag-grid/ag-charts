---
import { MetaData } from './lib/MetaData';
import { Scripts } from './lib/Scripts';
import Styles from './lib/Styles.astro';
import { ExampleModules } from './lib/ExampleModules';
import { getCacheBustingUrl } from '@utils/chartLibraryPaths';

interface Props {
    isDev: boolean;
    title: string;

    modifiedTimeMs: number;
    entryFileName: string;

    /**
     * Extra script file names (not including entry file)
     */
    scriptFiles?: string[];
    styleFiles?: string[];
    appLocation: string;
    /**
     * Whether to transpile the example's sources in the page instead of serving them transpiled
     */
    transpileInBrowser?: boolean;
    children?: any;
    headFragment?: string;
}

const {
    isDev,
    title,
    modifiedTimeMs,
    appLocation,
    entryFileName,
    scriptFiles = [],
    styleFiles = [],
    headFragment,
    transpileInBrowser,
} = Astro.props as Props;
---

<html lang="en">
    <head>
        <MetaData isDev={isDev} title={`Vue 3 Example - ${title}`} modifiedTimeMs={modifiedTimeMs} />

        <Styles
            baseUrl={appLocation}
            files={isDev ? styleFiles.map((file: string) => getCacheBustingUrl(file, modifiedTimeMs)) : styleFiles}
        />
        <Fragment set:html={headFragment} />
    </head>
    <body>
        <div id="app"><my-component></my-component></div>

        <Scripts baseUrl={appLocation} files={scriptFiles} />
        <ExampleModules
            appLocation={appLocation}
            entryFileName={entryFileName}
            framework={'vue3'}
            transpileInBrowser={transpileInBrowser}
        />
        <slot />
    </body>
</html>
