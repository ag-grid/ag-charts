---
/**
 * IBM Plex Sans leads the default chart theme's font stack. Canvas text never triggers a font
 * download, so it has to be declared here for the chart's `FontManager` to load it and re-render;
 * the library itself stays opted out, as `loadGoogleFonts` defaults to `false`.
 *
 * Must stay an Astro component: @astrojs/react@5 strips `<link>` tags from React output.
 */
interface Props {
    headFragment?: string;
}

const { headFragment } = Astro.props as Props;

// The security examples pin `style-src` to `'self'` and nonces to assert behaviour under a strict
// policy, so a cross-origin stylesheet would be blocked and log the very console error they check
// for. Leave those examples on the fallback font.
const declaresOwnCsp = headFragment?.includes('Content-Security-Policy') ?? false;

const FONT_HREF = 'https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;700&display=swap';
---

{
    !declaresOwnCsp && (
        <Fragment>
            <link rel="preconnect" href="https://fonts.googleapis.com" />
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
            <link href={FONT_HREF} rel="stylesheet" />
        </Fragment>
    )
}
