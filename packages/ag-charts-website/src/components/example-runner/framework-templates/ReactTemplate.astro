---
import { MetaData } from './lib/MetaData';
import ExampleFonts from './lib/ExampleFonts.astro';
import Styles from './lib/Styles.astro';
import { ExampleModules } from './lib/ExampleModules';
import { Scripts } from './lib/Scripts';
import { getCacheBustingUrl } from '@utils/chartLibraryPaths';

interface Props {
    isDev: boolean;
    title: string;

    modifiedTimeMs: number;
    entryFileName: string;

    /**
     * Extra script file names (not including entry file)
     */
    scriptFiles?: string[];
    styleFiles?: string[];
    appLocation: string;
    ignoreModuleLoader?: boolean;
    /**
     * Whether to transpile the example's sources in the page instead of serving them transpiled
     */
    transpileInBrowser?: boolean;
    children?: any;
    headFragment?: string;
}

const {
    title,
    isDev,
    modifiedTimeMs,
    appLocation,
    entryFileName,
    scriptFiles = [],
    styleFiles = [],
    ignoreModuleLoader,
    headFragment,
    transpileInBrowser,
} = Astro.props as Props;
---

<html lang="en">
    <head>
        <MetaData isDev={isDev} title={`React Example - ${title}`} modifiedTimeMs={modifiedTimeMs} />

        <ExampleFonts headFragment={headFragment} />

        <Styles
            baseUrl={appLocation}
            files={isDev ? styleFiles.map((file: string) => getCacheBustingUrl(file, modifiedTimeMs)) : styleFiles}
        />
        <Fragment set:html={headFragment} />
    </head>
    <body>
        <div id="root"></div>
        {scriptFiles && <Scripts baseUrl={appLocation} files={scriptFiles} />}
        {
            !ignoreModuleLoader && (
                <ExampleModules
                    appLocation={appLocation}
                    entryFileName={entryFileName}
                    framework={'react'}
                    transpileInBrowser={transpileInBrowser}
                />
            )
        }
        <slot />
    </body>
</html>
