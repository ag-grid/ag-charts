---
import { MetaData } from './lib/MetaData';
import { Styles } from './lib/Styles';
import { SystemJs } from './lib/SystemJs';
import { Scripts } from './lib/Scripts';
import { getCacheBustingUrl } from '@utils/chartLibraryPaths';
import { pathJoin } from '@utils/pathJoin';

interface Props {
    isDev: boolean;
    title: string;

    modifiedTimeMs: number;
    entryFileName: string;

    /**
     * Extra script file names (not including entry file)
     */
    scriptFiles?: string[];
    styleFiles?: string[];
    appLocation: string;
    boilerplatePath: string;
    ignoreSystemJs?: boolean;
    children?: any;
    headFragment?: string;
}

const {
    title,
    isDev,
    modifiedTimeMs,
    appLocation,
    entryFileName,
    scriptFiles = [],
    styleFiles = [],
    boilerplatePath,
    ignoreSystemJs,
    headFragment,
} = Astro.props as Props;

const startFile = pathJoin(appLocation, entryFileName);
---

<html lang="en">
    <head>
        <MetaData isDev={isDev} title={`React Example - ${title}`} modifiedTimeMs={modifiedTimeMs} />

        <Styles
            baseUrl={appLocation}
            files={isDev ? styleFiles.map((file: string) => getCacheBustingUrl(file, modifiedTimeMs)) : styleFiles}
        />
        <Fragment set:html={headFragment} />
    </head>
    <body>
        <div id="root"></div>
        {scriptFiles && <Scripts baseUrl={appLocation} files={scriptFiles} />}
        {
            !ignoreSystemJs && (
                <SystemJs
                    isDev={isDev}
                    boilerplatePath={boilerplatePath}
                    appLocation={appLocation}
                    startFile={startFile}
                    internalFramework={'react'}
                />
            )
        }
        <slot />
    </body>
</html>
