---
import type { InternalFramework } from '@ag-grid-types';
import FrameworkTemplate from '@components/example-runner/components/FrameworkTemplate.astro';
import { getExampleUrl } from '../utils/urlPaths';
import { getGeneratedContents } from '../../example-generator';

interface Props {
    internalFramework: InternalFramework;
    pageName: string;
    exampleName: string;
    /**
     * Whether to use relative paths for script files references
     */
    relativePath?: boolean;
    /**
     * Whether to add a script to post an `init` message to the parent
     */
    addInitMessageScript?: boolean;
    /**
     * Whether to add a script to check for E2E tests
     */
    addE2ECheckScript?: boolean;
    /**
     * Whether to add padding to the body element
     */
    addExternalExampleStyles?: boolean;
    /**
     * Whether to skip the example module loader (import map + entry module)
     */
    ignoreModuleLoader?: boolean;
    /**
     * Whether to transpile the example's sources in the page instead of serving them transpiled
     */
    transpileInBrowser?: boolean;
    /**
     * Ignore dark mode (always use light mode)
     */
    ignoreDarkMode?: boolean;
}

const {
    internalFramework,
    pageName,
    exampleName,
    relativePath,
    addInitMessageScript,
    addE2ECheckScript,
    addExternalExampleStyles,
    ignoreModuleLoader,
    transpileInBrowser,
    ignoreDarkMode,
} = Astro.props as Props;

const generatedContents = await getGeneratedContents({
    type: 'docs',
    framework: internalFramework,
    pageName,
    exampleName,
});
const exampleUrl = getExampleUrl({
    internalFramework,
    pageName,
    exampleName,
});
---

<FrameworkTemplate
    internalFramework={internalFramework}
    pageName={pageName}
    exampleName={exampleName}
    exampleUrl={exampleUrl}
    generatedContents={generatedContents!}
    relativePath={relativePath}
    addInitMessageScript={addInitMessageScript}
    ignoreModuleLoader={ignoreModuleLoader}
    transpileInBrowser={transpileInBrowser}
    addE2ECheckScript={addE2ECheckScript}
    addExternalExampleStyles={addExternalExampleStyles}
    ignoreDarkMode={ignoreDarkMode}
/>
