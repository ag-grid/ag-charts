---
import { DocsExampleRunner } from './DocsExampleRunner';
import type { ExampleType } from '@components/example-generator/types';
import ExampleRunnerContainer from '@components/example-runner/components/ExampleRunnerContainer.astro';
import ExampleRunnerSourceCode from '@components/example-runner/components/ExampleRunnerSourceCode.astro';
import { getExampleViewerFiles } from '@components/example-runner/utils/exampleViewerFiles';
import type { ExampleOptions } from '@components/example-runner/types';
import { getGeneratedContents } from '@components/example-generator';
import { DISABLE_EXAMPLE_SOURCE_EMBED } from '@constants';
import { getInternalFramework } from '@utils/framework';
import { getFrameworkFromPath, getPageNameFromPath } from '../utils/urlPaths';

interface Props {
    title: string;
    name: string;
    type: ExampleType;
    options: ExampleOptions;
    /**
     * If inline, there is margin on the bottom
     */
    isInline?: boolean;
    initialLoadDeferred?: boolean;
}

const { title, name, type, options, isInline, initialLoadDeferred } = Astro.props as Props;

const pageName = getPageNameFromPath(Astro.url.pathname);
const framework = getFrameworkFromPath(Astro.url.pathname);

// The TypeScript variant, as the markdown twin page embeds, so crawlers get the same source from
// both. A visitor's own language choice is still fetched by the island as before.
const internalFramework = getInternalFramework({ framework, useTypescript: true });
const generatedExampleParams = {
    type: 'docs',
    framework: internalFramework,
    pageName,
    exampleName: name,
};
// NOTE: The island still fetches the contents at runtime rather than taking them as props, so the
// page only carries the source once: in the crawlable panel below, which the island removes once
// it has mounted.
const contents = await getGeneratedContents(generatedExampleParams);
// Resolved at build time so the console log can be shown on page load.
const hasExampleConsoleLog = contents?.hasExampleConsoleLog;
const sourceCode =
    contents && !DISABLE_EXAMPLE_SOURCE_EMBED ? getExampleViewerFiles(contents, internalFramework) : undefined;
---

<ExampleRunnerContainer
    exampleHeight={options?.exampleHeight}
    exampleWidth={options?.exampleWidth}
    pageName={pageName}
    exampleName={name}
    isInline={isInline}
    hasExampleConsoleLog={hasExampleConsoleLog}
>
    <DocsExampleRunner
        client:visible={{ rootMargin: '200px' }}
        title={title}
        name={name}
        exampleType={type}
        options={options}
        pageName={pageName}
        hasExampleConsoleLog={hasExampleConsoleLog}
        initialLoadDeferred={initialLoadDeferred}
    />
    {
        sourceCode && (
            <ExampleRunnerSourceCode
                internalFramework={internalFramework}
                files={sourceCode.files}
                mainFileName={sourceCode.mainFileName}
            />
        )
    }
</ExampleRunnerContainer>
