---
/**
 * ChartTypesGridSection.astro - Display available chart types with thumbnails
 *
 * Shows all available chart types organized in a grid, with representative
 * example thumbnails and enterprise badges where applicable.
 */
import type { LandingPageContent } from '@ag-website-shared/components/landing-pages/types';
import type { ChartTypesGridSection as ChartTypesGridSectionType } from '../../types';
import { LandingPageSection } from '@ag-website-shared/components/landing-pages/LandingPageSection';
import { getEntry, type CollectionEntry } from 'astro:content';
import { GalleryExampleImage } from '@components/gallery/components/GalleryExampleImage';
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';
import styles from '@pages-styles/landing-page.module.scss';

interface Props {
    section: ChartTypesGridSectionType;
    pageContent: LandingPageContent;
}

const { section, pageContent } = Astro.props;
const filter = section.filter ?? 'all';

// Load gallery data
const galleryDataEntry = (await getEntry('gallery', 'data')) as CollectionEntry<'gallery'>;
const galleryData = galleryDataEntry.data;

// Extract chart types from gallery data
// The series array is nested: series: Array<Array<ChartType>>
const allChartTypes = galleryData.series.flat();

// Filter based on enterprise/community preference
const filteredChartTypes = allChartTypes.filter((chartType) => {
    if (filter === 'all') return true;
    if (filter === 'enterprise') return chartType.enterprise === true;
    if (filter === 'community') return chartType.enterprise !== true;
    return true;
});

// Get the first non-hidden example for each chart type as representative
const chartTypesWithExamples = filteredChartTypes
    .map((chartType) => {
        const visibleExamples = chartType.examples.filter((ex) => !ex.hidden);
        const representativeExample = visibleExamples[0];
        if (!representativeExample) return null;

        const seriesLink = chartType.seriesLink ?? `./${chartType.seriesName}-series/`;

        return {
            title: chartType.title,
            seriesName: chartType.seriesName,
            enterprise: chartType.enterprise ?? false,
            exampleName: representativeExample.name,
            docsUrl: urlWithBaseUrl(seriesLink),
        };
    })
    .filter(Boolean);
---

<LandingPageSection
    id="chart-types"
    tag={section.tag}
    heading={section.heading}
    subHeading={section.subHeading}
    showBackgroundGradient={section.showBackgroundGradient}
>
    <div class={styles.chartTypesGrid}>
        {
            chartTypesWithExamples.map((chartType) => (
                <a
                    href={chartType.docsUrl}
                    class:list={[
                        styles.chartTypeCard,
                        `plausible-event-name=${pageContent.analyticsPrefix}-charttype-${chartType.seriesName}`,
                    ]}
                >
                    <div class={styles.chartTypeImageWrapper}>
                        <GalleryExampleImage
                            client:visible
                            exampleName={chartType.exampleName}
                            label={chartType.title}
                            enableDprScaling={true}
                            className={styles.chartTypeImage}
                        />
                    </div>
                    <span class={styles.chartTypeTitle}>{chartType.title}</span>
                    {chartType.enterprise && <span class={styles.chartTypeEnterpriseBadge}>Enterprise</span>}
                </a>
            ))
        }
    </div>
</LandingPageSection>
