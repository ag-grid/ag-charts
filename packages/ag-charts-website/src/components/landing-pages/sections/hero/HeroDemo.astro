---
/**
 * HeroDemo.astro - Hero section demo component for AG Charts landing pages
 *
 * Embeds a gallery example as an interactive chart demo in the hero section.
 * Uses the existing GalleryExampleRunner infrastructure.
 */
import { getEntry, type CollectionEntry } from 'astro:content';
import ExampleRunnerContainer from '@components/example-runner/components/ExampleRunnerContainer.astro';
import { GalleryExampleRunner } from '@components/gallery/components/GalleryExampleRunner';
import { getChartExampleTitle, getSeriesTypeSlug } from '@components/gallery/utils/filesData';
import { getLoadingIFrameId } from '@ag-website-shared/components/loading-logo/getElementId';

interface Props {
    /** Gallery example name to display */
    exampleName: string;
    /** Height of the demo in pixels */
    height?: number;
}

const { exampleName, height = 500 } = Astro.props;

const galleryDataEntry = (await getEntry('gallery', 'data')) as CollectionEntry<'gallery'>;
const title = getChartExampleTitle({
    galleryData: galleryDataEntry.data,
    exampleName,
});
const pageName = getSeriesTypeSlug({
    galleryData: galleryDataEntry.data,
    exampleName,
});
const loadingIFrameId = getLoadingIFrameId({ pageName, exampleName });
---

<div class="hero-demo-container">
    <ExampleRunnerContainer pageName={pageName} exampleName={exampleName} exampleHeight={height}>
        <GalleryExampleRunner
            client:load
            title={title}
            exampleName={exampleName}
            loadingIFrameId={loadingIFrameId}
            hideCode={true}
            hideExternalLinks={true}
        />
    </ExampleRunnerContainer>
</div>

<style>
    .hero-demo-container {
        width: 100%;
        border-radius: var(--radius-lg);
        overflow: hidden;
        border: 1px solid var(--color-border-primary);
        background-color: var(--color-bg-primary);
    }

    .hero-demo-container :global(.example-runner-outer) {
        margin: 0 !important;
    }
</style>
