---
// cspell:ignore whats Whats
/**
 * LandingPage.astro - Content-driven landing page template for AG Charts
 *
 * This component renders a landing page based on a JSON content definition.
 * Each section in the content.sections array is rendered in order.
 *
 * Usage:
 * ```astro
 * ---
 * import LandingPage from '@components/landing-pages/LandingPage.astro';
 * import { getEntry } from 'astro:content';
 *
 * const { data: content } = await getEntry('landingPages', 'react-charts');
 * const { data: versions } = await getEntry('versions', 'ag-charts-versions');
 * ---
 * <LandingPage content={content} versions={versions} />
 * ```
 */

import type {
    LandingPageContent,
    HeroSection as HeroSectionType,
    IntegratedChartsSection as IntegratedChartsSectionType,
} from '@ag-website-shared/components/landing-pages/types';
import type {
    GalleryShowcaseSection as GalleryShowcaseSectionType,
    ChartTypesGridSection as ChartTypesGridSectionType,
    InteractiveDemoSection as InteractiveDemoSectionType,
    ChartExplorerSection as ChartExplorerSectionType,
    FinancialChartsSection as FinancialChartsSectionType,
    MapChartsSection as MapChartsSectionType,
    WhatsNewSection as WhatsNewSectionType,
    PerformanceDemoSection as PerformanceDemoSectionType,
    CodeExampleSection as CodeExampleSectionType,
    FeatureGridSection as FeatureGridSectionType,
    ChartTypesShowcaseSection as ChartTypesShowcaseSectionType,
} from './types';
import Layout from '@layouts/Layout.astro';
import styles from '@pages-styles/landing-page.module.scss';
import frameworkStyles from '@pages-styles/framework-landing-page.module.scss';
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';
import { getHeadingWithLogo } from '@utils/framework-landing-page-utils';

// Shared section components from @ag-website-shared
import HeroSection from '@ag-website-shared/components/landing-pages/sections/HeroSection.astro';
import FeaturesSection from '@ag-website-shared/components/landing-pages/sections/FeaturesSection.astro';
import CustomersSection from '@ag-website-shared/components/landing-pages/sections/CustomersSection.astro';
import ExamplesSection from '@ag-website-shared/components/landing-pages/sections/ExamplesSection.astro';
import FAQSection from '@ag-website-shared/components/landing-pages/sections/FAQSection.astro';
import ContactSection from '@ag-website-shared/components/landing-pages/sections/ContactSection.astro';
import { LandingPageSection } from '@ag-website-shared/components/landing-pages/LandingPageSection';
import { TrialButton } from '@ag-website-shared/components/trial-licence-modal/TrialButton';
import { InstallText } from '@ag-website-shared/components/install-text/InstallText';

// Charts-specific section components
import { HeroGallery } from './sections/hero/HeroGallery';
import GalleryShowcaseSection from './sections/gallery-showcase/GalleryShowcaseSection.astro';
import ChartTypesGridSection from './sections/chart-types/ChartTypesGridSection.astro';
import InteractiveDemoSection from './sections/interactive-demo/InteractiveDemoSection.astro';
import FinancialChartsSection from './sections/financial-charts/FinancialChartsSection.astro';
import MapChartsSection from './sections/map-charts/MapChartsSection.astro';
import IntegratedChartsSection from './sections/integrated-charts/IntegratedChartsSection.astro';
import WhatsNewSection from './sections/whats-new/WhatsNewSection.astro';
import PerformanceDemoSection from './sections/performance-demo/PerformanceDemoSection.astro';
import FeaturesWithExamples from './sections/features-with-examples/FeaturesWithExamples.astro';
import CodeExampleSection from './sections/code-example/CodeExampleSection.astro';
import FeatureGridSection from './sections/feature-grid/FeatureGridSection.astro';
import ChartTypesShowcaseSection from './sections/chart-types-showcase/ChartTypesShowcaseSection.astro';
import ComparisonTable from './sections/comparison/ComparisonTable';

// Site-specific components
import { CustomerLogos } from '@components/customer-logos/CustomerLogos';

interface Props {
    content: LandingPageContent;
    versions?: Array<{
        version: string;
        landingPageHighlight?: string;
    }>;
}

const { content, versions } = Astro.props;
const latestVersion = versions?.find((v) => v.landingPageHighlight) ?? versions?.[0];

// For framework pages, add logo to headings (only for specific framework landing pages)
// Check against analyticsPrefix since it matches the page slug (e.g., 'angular-charts')
const frameworkLandingPageSlugs = [
    'react-charts',
    'javascript-charts',
    'vue-charts',
    'angular-charts',
    'enterprise-charts',
];
const isFrameworkLandingPage = content.framework && frameworkLandingPageSlugs.includes(content.analyticsPrefix);
const frameworkKey = isFrameworkLandingPage ? content.framework || '' : '';
const pageStyles = isFrameworkLandingPage ? frameworkStyles : styles;
---

<Layout title={content.meta.title} description={content.meta.description} showDocsNav={false} showSearchBar={true}>
    {
        content.sections.map((section) => {
            switch (section.type) {
                case 'hero':
                    // Hero section using shared component with auto-scrolling gallery
                    // Add logo to heading for framework landing pages only
                    const heroSec = section as HeroSectionType;
                    const heroSectionWithLogo =
                        isFrameworkLandingPage && frameworkKey
                            ? {
                                  ...heroSec,
                                  headingHtml: getHeadingWithLogo(frameworkKey, heroSec.heading, urlWithBaseUrl),
                              }
                            : heroSec;

                    return (
                        <HeroSection
                            section={heroSectionWithLogo}
                            pageContent={content}
                            latestVersion={latestVersion}
                            urlWithBaseUrl={urlWithBaseUrl}
                            styles={pageStyles}
                        >
                            {/* Hero demo slot - auto-scrolling gallery carousel */}
                            {heroSec.galleryExamples && heroSec.galleryExamples.length > 0 && (
                                <HeroGallery
                                    slot="hero-demo"
                                    client:load
                                    examples={heroSec.galleryExamples}
                                    height={heroSec.demoHeight ?? 500}
                                    autoAdvanceDelay={7000}
                                    framework={content.framework}
                                />
                            )}

                            {/* Install text slot */}
                            <InstallText slot="hero-install" client:load packageName={content.packageName} />
                            {section.primaryCta?.useTrialButton && (
                                <TrialButton
                                    slot="hero-trial-button"
                                    client:load
                                    className={`button-secondary ${styles.heroSectionCta1} plausible-event-name=${content.analyticsPrefix}-trial-cta`}
                                >
                                    {section.primaryCta.text}
                                </TrialButton>
                            )}
                            {/* Customer logos slot */}
                            <CustomerLogos slot="hero-logos" client:load />
                        </HeroSection>
                    );

                case 'features':
                    // Add logo to heading for framework landing pages only
                    const featuresSectionWithLogo =
                        isFrameworkLandingPage && frameworkKey
                            ? {
                                  ...section,
                                  headingHtml: getHeadingWithLogo(
                                      frameworkKey,
                                      section.heading || 'Build, Customise and Expand your Charts',
                                      urlWithBaseUrl
                                  ),
                              }
                            : section;
                    return (
                        <FeaturesSection section={featuresSectionWithLogo} pageContent={content}>
                            <FeaturesWithExamples features={section.items} framework={content.framework} />
                        </FeaturesSection>
                    );

                case 'customers':
                    return (
                        <CustomersSection section={section} pageContent={content}>
                            <CustomerLogos client:load />
                        </CustomersSection>
                    );

                case 'examples':
                    return (
                        <ExamplesSection
                            section={section}
                            pageContent={content}
                            urlWithBaseUrl={urlWithBaseUrl}
                            styles={pageStyles}
                        />
                    );

                case 'faq':
                    return <FAQSection section={section} pageContent={content} />;

                case 'contact':
                    return (
                        <ContactSection section={section} pageContent={content} styles={pageStyles}>
                            <CustomerLogos slot="contact-logos" client:load />
                        </ContactSection>
                    );

                // Charts-specific sections
                case 'gallery-showcase':
                    return (
                        <GalleryShowcaseSection section={section as GalleryShowcaseSectionType} pageContent={content} />
                    );

                case 'chart-types':
                    return (
                        <ChartTypesGridSection section={section as ChartTypesGridSectionType} pageContent={content} />
                    );

                case 'interactive-demo':
                    return (
                        <InteractiveDemoSection section={section as InteractiveDemoSectionType} pageContent={content} />
                    );

                case 'financial-charts':
                    return (
                        <FinancialChartsSection section={section as FinancialChartsSectionType} pageContent={content} />
                    );

                case 'map-charts':
                    return <MapChartsSection section={section as MapChartsSectionType} pageContent={content} />;

                case 'integrated-charts':
                    return (
                        <IntegratedChartsSection
                            section={section as IntegratedChartsSectionType}
                            pageContent={content}
                        />
                    );

                case 'whats-new':
                    return <WhatsNewSection section={section as WhatsNewSectionType} pageContent={content} />;

                case 'performance-demo':
                    return (
                        <PerformanceDemoSection section={section as PerformanceDemoSectionType} pageContent={content} />
                    );

                case 'comparison':
                    return (
                        <LandingPageSection
                            id="comparison"
                            tag={section.tag}
                            heading={section.heading}
                            subHeading={section.subHeading}
                            showBackgroundGradient={section.showBackgroundGradient}
                        >
                            <ComparisonTable client:load />
                        </LandingPageSection>
                    );

                case 'code-example':
                    return <CodeExampleSection section={section as CodeExampleSectionType} pageContent={content} />;

                case 'feature-grid':
                    return <FeatureGridSection section={section as FeatureGridSectionType} pageContent={content} />;

                case 'chart-types-showcase':
                    return (
                        <ChartTypesShowcaseSection
                            section={section as ChartTypesShowcaseSectionType}
                            pageContent={content}
                        />
                    );

                case 'pricing':
                    return (
                        <LandingPageSection
                            id="pricing"
                            tag={section.tag}
                            heading={section.heading}
                            subHeading={section.subHeading}
                            showBackgroundGradient={section.showBackgroundGradient}
                        >
                            <div class={styles.pricingContainer}>
                                {section.cards.map((card) => (
                                    <div class={styles.pricingCard}>
                                        <h3>{card.title}</h3>
                                        <div
                                            class={
                                                card.price === 'Free' ? styles.pricingPriceFree : styles.pricingPrice
                                            }
                                        >
                                            {card.price}
                                        </div>
                                        <p class={styles.pricingPriceNote}>{card.priceNote}</p>
                                        <ul class={styles.pricingFeatures}>
                                            {card.features.map((feature) => (
                                                <li>{feature}</li>
                                            ))}
                                        </ul>
                                        <a
                                            id={card.ctaId}
                                            class:list={[
                                                card.isPrimary ? 'button-tertiary' : 'button-secondary',
                                                styles.pricingCta,
                                                `plausible-event-name=${content.analyticsPrefix}-${card.title.toLowerCase().replace(/\s+/g, '-')}-cta`,
                                            ]}
                                            href={
                                                card.ctaUrl.startsWith('http')
                                                    ? card.ctaUrl
                                                    : urlWithBaseUrl(card.ctaUrl)
                                            }
                                        >
                                            {card.ctaText}
                                        </a>
                                        {card.showTrialButton && (
                                            <TrialButton
                                                client:load
                                                className={`button-secondary ${styles.pricingTrialCta} plausible-event-name=${content.analyticsPrefix}-${card.title.toLowerCase().replace(/\s+/g, '-')}-trial-cta`}
                                            >
                                                Free Trial
                                            </TrialButton>
                                        )}
                                    </div>
                                ))}
                            </div>
                        </LandingPageSection>
                    );

                default:
                    // Unknown section type - skip
                    return null;
            }
        })
    }
</Layout>
