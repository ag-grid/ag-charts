---
import { getEntry, type CollectionEntry } from 'astro:content';
import { GALLERY_IMAGE_DPR_ENHANCEMENT } from '@constants';
import { galleryFamilyName } from '../utils/gallerySeo';
import { getFamilyExamples } from '../utils/relatedExamples';
import { GalleryExampleLink } from './GalleryExampleLink';

interface Props {
    /** Chart family key, as `seriesName` in `content/gallery/data.json`. */
    series: string;
}

const { series } = Astro.props;

const galleryEntry = (await getEntry('gallery', 'data')) as CollectionEntry<'gallery'>;
const family = getFamilyExamples({ galleryData: galleryEntry.data, seriesName: series });
---

<p>
    Every {galleryFamilyName(family.title)} example in the <a href={family.hubUrl}>AG Charts gallery</a>:
</p>

<div class="cards">
    {
        family.examples.map(({ label, name }) => (
            <GalleryExampleLink
                client:visible
                label={label}
                exampleName={name}
                enableDprScaling={GALLERY_IMAGE_DPR_ENHANCEMENT}
                layout="fill"
            />
        ))
    }
</div>

<style lang="scss">
    @use 'design-system' as *;

    // Auto-filled rather than a fixed column count: a family holds anywhere from one example
    // to a dozen, and a part-filled last row is fine.
    .cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: $spacing-size-4;
        margin-bottom: $spacing-size-6;
    }
</style>
