---
import { getEntry, type CollectionEntry } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import { Icon } from '@ag-website-shared/components/icon/Icon';
import GalleryExampleRunner from '@components/gallery/components/GalleryExampleRunner.astro';
import { getGalleryPages } from '@components/gallery/utils/pageData';
import { GalleryExampleCarousel } from '@components/gallery/components/GalleryExampleCarousel';
import { GallerySeriesLink } from '@components/gallery/components/GallerySeriesLink';
import { resolveGallerySeo } from '@components/gallery/utils/gallerySeo';
import { relatedExamplesHeading } from '@components/gallery/utils/relatedExamples';
import { GALLERY_FRAMEWORK_LINKS } from '@components/gallery/galleryFrameworkLinks';
import { GALLERY_IMAGE_DPR_ENHANCEMENT } from '@constants';

export async function getStaticPaths() {
    const galleryEntry = (await getEntry('gallery', 'data')) as CollectionEntry<'gallery'>;

    const pages = getGalleryPages({ galleryData: galleryEntry.data });
    return pages;
}

const { page, relatedExamples } = Astro.props;
const exampleName = Astro.params.pageName;

// Shared with the page's `.md` twin so the two describe the example identically.
const seo = resolveGallerySeo(page.name);
const relatedHeading = relatedExamplesHeading({ seriesTitle: page.seriesTitle, related: relatedExamples });
---

<Layout title={seo.title} description={seo.description} showSearchBar={true}>
    <div class="gallery-page-container layout-max-width-small text-base">
        <div class="title-container">
            <h1>{seo.h1}</h1>
            {
                page.enterprise && (
                    <span class="enterpriseIcon">
                        <Icon client:only="react" name="enterprise" />
                    </span>
                )
            }
        </div>

        <div class="seriesDocsLink text-secondary">
            <GallerySeriesLink client:only="react" series={page.seriesTitle} link={page.seriesLink} />
        </div>

        <p class="intro">{seo.intro}</p>

        <p class="frameworkLinks text-secondary">
            {/* Array children are concatenated verbatim, so indentation cannot add stray spaces. */}
            {
                [
                    'Get started with ',
                    ...GALLERY_FRAMEWORK_LINKS.flatMap(({ label, url }, i) => [
                        i === 0 ? '' : i === GALLERY_FRAMEWORK_LINKS.length - 1 ? ' or ' : ', ',
                        <a href={url}>{label}</a>,
                    ]),
                    '.',
                ]
            }
        </p>

        <GalleryExampleRunner exampleName={exampleName} />

        {
            relatedExamples.length > 0 && (
                <Fragment>
                    <h2 class="moreExampleLabel">{relatedHeading}</h2>

                    <p class="moreExampleHubLink text-secondary">
                        <a href={page.galleryHubUrl}>View All Examples</a>
                    </p>

                    <GalleryExampleCarousel
                        client:visible
                        examples={relatedExamples}
                        enableDprScaling={GALLERY_IMAGE_DPR_ENHANCEMENT}
                        label={relatedHeading}
                    />
                </Fragment>
            )
        }
    </div>
</Layout>

<style lang="scss">
    @use 'design-system' as *;

    .gallery-page-container {
        padding-top: $spacing-size-10;
        padding-bottom: $spacing-size-32;

        @media screen and (min-width: $breakpoint-gallery-small) {
            padding-top: $spacing-size-16;
        }
    }

    .title-container {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0 $spacing-size-2;
        padding-bottom: $spacing-size-2;
    }

    // Sits directly under the title, styled as the framework links below the intro.
    .seriesDocsLink {
        margin-bottom: $spacing-size-4;
        font-size: var(--text-fs-sm);
    }

    .intro {
        margin-bottom: $spacing-size-2;
        font-size: var(--text-fs-sm);
    }

    .frameworkLinks {
        max-width: 70ch;
        margin-bottom: $spacing-size-6;
        font-size: var(--text-fs-sm);
    }

    h1 {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        margin-bottom: 0;
    }

    .enterpriseIcon {
        --icon-size: 28px;
        --icon-color: var(--color-enterprise-icon);
    }

    .moreExampleLabel {
        margin-top: $spacing-size-24;
        margin-bottom: $spacing-size-1;
        text-align: center;
    }

    .moreExampleHubLink {
        margin-bottom: $spacing-size-6;
        text-align: center;
    }
</style>

<style lang="scss" is:global>
    @use 'design-system' as *;

    @media screen and (max-width: 920px) {
        .container > * > div {
            min-height: calc(480px + 48px) !important;
        }

        .tabs-content {
            height: 480px !important;
        }
    }

    .icon {
        transition: fill $transition-default-timing;
    }
</style>
