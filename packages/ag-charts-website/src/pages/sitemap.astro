---
// cspell:ignore sitemaputils
import { Sitemap } from '@ag-website-shared/components/sitemap/Sitemap';
import parseSitemap from '@ag-website-shared/components/sitemap/utils/sitemaputils';
import Layout from '../layouts/Layout.astro';
import { LIVE_SITEMAP_URL } from '../constants';

let parsedSitemap = [];
if (LIVE_SITEMAP_URL != null) {
    const response = await fetch(LIVE_SITEMAP_URL);
    const xmlSitemap = await response.text();
    parsedSitemap = parseSitemap(xmlSitemap);
}
---

<Layout
    title={'Sitemap | AG Charts'}
    description={'The AG Charts sitemap. Contains links to every page on the site, including docs.'}
    showDocsNav={false}
    showSearchBar={true}
>
    <div class:list={['contentViewport layout-grid']}>
        <Sitemap client:load sitemap={parsedSitemap} site="Charts" />
    </div>
</Layout>
