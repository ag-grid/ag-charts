---
import { getCollection } from 'astro:content';
import type { InternalFramework } from '@ag-grid-types';
import DocsFrameworkTemplate from '@components/docs/components/DocsFrameworkTemplate.astro';
import { getDocsExamplePages } from '@components/docs/utils/pageData';
import { isReactInternalFramework } from '@utils/framework';
import { getHmrEnabled } from '@utils/env';

/**
 * This page is the same as `[exampleName].astro`, but for Code Sandbox examples
 */
export async function getStaticPaths() {
    const pages = await getCollection('docs');
    return getDocsExamplePages({
        pages,
    });
}

// NOTE: Render as a partial, so that astro does not insert any website scripts (eg, hot reload) and styles into the page
export const partial = !getHmrEnabled();

const { internalFramework, pageName, exampleName } = Astro.params;

// Only the React CodeSandbox template has a build step; every other framework runs on `static`
// and so must transpile the example's TypeScript in the page.
const ignoreModuleLoader = isReactInternalFramework(internalFramework);
---

<DocsFrameworkTemplate
    internalFramework={internalFramework as InternalFramework}
    pageName={pageName!}
    exampleName={exampleName!}
    relativePath={true}
    ignoreModuleLoader={ignoreModuleLoader}
    transpileInBrowser={!ignoreModuleLoader}
    addExternalExampleStyles={true}
    ignoreDarkMode={true}
/>
