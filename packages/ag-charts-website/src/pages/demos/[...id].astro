---
import { readFileSync, readdirSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

// getStaticPaths runs in isolation and cannot reference component-scope consts.
export function getStaticPaths() {
    // Archive builds are noindex and omit the sitemap, so demos have nothing to gain there.
    if (import.meta.env.BASE_URL?.includes('archive')) {
        return [];
    }

    const demosDir = fileURLToPath(new URL('../../../../ag-charts-demos/src/demos', import.meta.url));
    const ids = readdirSync(demosDir, { withFileTypes: true })
        .filter((entry) => entry.isDirectory())
        .map((entry) => entry.name);

    // `id: undefined` is the index listing (`/demos`); each id is one demo.
    return [{ params: { id: undefined } }, ...ids.map((id) => ({ params: { id } }))];
}

// A `partial` so Astro injects no page scaffolding around the demos SPA shell.
export const partial = true;

const { id } = Astro.params;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Index listing: enumerate the registered demos and link to each shell.
let demoIds: string[] = [];
if (!id) {
    const demosDir = fileURLToPath(new URL('../../../../ag-charts-demos/src/demos', import.meta.url));
    demoIds = readdirSync(demosDir, { withFileTypes: true })
        .filter((entry) => entry.isDirectory())
        .map((entry) => entry.name)
        .sort();
}

const distIndex = fileURLToPath(new URL('../../../../ag-charts-demos/dist/index.html', import.meta.url));

// The demos build is base-relative, so its chunks resolve against the entry URL; the hashed
// entry filename is only recoverable from the built index.html.
let entrySrc: string | undefined;
if (id) {
    try {
        const entryFile = readFileSync(distIndex, 'utf8').match(/src="[^"]*\/assets\/([^"]+\.js)"/)?.[1];
        entrySrc = entryFile && `${base}/internal-demos/assets/${entryFile}`;
    } catch {
        entrySrc = undefined;
    }
}
---

<!doctype html>
{
    !id ? (
        <html lang="en">
            <head>
                <meta charset="utf-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1" />
                <meta name="robots" content="noindex" />
                <title>Demos</title>
                {/* Partial routes get no auto-injected client, so the Vite HMR client that
                    carries the watch loop's reload signal has to be pulled in by hand. */}
                {import.meta.env.DEV && <script type="module" src="/@vite/client" />}
            </head>
            <body style="margin: 0; padding: 24px; font-family: system-ui, sans-serif;">
                <h1>AG Charts demo apps</h1>
                {demoIds.length ? (
                    <ul>
                        {demoIds.map((demoId) => (
                            <li>
                                <a href={`${base}/demos/${demoId}/`}>{demoId}</a>
                            </li>
                        ))}
                    </ul>
                ) : (
                    <p>No demo apps are registered.</p>
                )}
            </body>
        </html>
    ) : (
        <html lang="en" style="height: 100%;">
            <head>
                <meta charset="utf-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1" />
                <meta name="robots" content="noindex" />
                <title>{`Demo: ${id}`}</title>
                {/* Partial routes get no auto-injected client, so the Vite HMR client that
                    carries the watch loop's reload signal has to be pulled in by hand. */}
                {import.meta.env.DEV && <script type="module" src="/@vite/client" />}
            </head>
            <body style="margin: 0; height: 100%;">
                <div id="root" data-demo-id={id} />
                {entrySrc ? (
                    <script type="module" src={entrySrc} />
                ) : (
                    <p>The demos bundle has not been built yet. Wait for `nx dev` to finish building, then reload.</p>
                )}
            </body>
        </html>
    )
}
