---
/**
 * React Charts Landing Page
 *
 * Content is defined in: src/content/landing-pages/react-charts.json
 *
 * Ad traffic only: the same content is canonical at /react/, so this copy carries a noindex.
 */

import LandingPage from '@components/landing-pages/LandingPage.astro';
import { getEntry } from 'astro:content';

const contentEntry = await getEntry('landingPages', 'react-charts');
const versionsEntry = await getEntry('versions', 'ag-charts-versions');

const content = contentEntry?.data;
const versions = versionsEntry?.data;
---

{content && <LandingPage content={content} versions={versions} noIndex={true} />}
