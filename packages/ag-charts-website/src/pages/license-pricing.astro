---
import { LicensePricing } from '@ag-website-shared/components/license-pricing/LicensePricing';
import PageHero from '@ag-website-shared/components/page-hero/PageHero.astro';
import Layout from '@layouts/Layout.astro';
---

<Layout
    title="AG Charts: License and Pricing"
    description="View license and pricing details for AG Charts. Compare features in AG Charts Community vs. Enterprise. Purchase AG Grid Bundle for a discount Grid & Charts licenses."
    showSearchBar={true}
    showDocsNav={false}
>
    <PageHero
        eyebrow="Licensing and Sales"
        headline="Pricing"
        subhead="Whether you are a startup, global enterprise or somewhere in between, AG Grid & AG Charts deliver best in class value."
    >
        <a class="button" href="#pricing">See our pricing</a>
    </PageHero>
    <LicensePricing client:load defaultSelection="charts" />
</Layout>
