---
import Layout from '@layouts/Layout.astro';
import { ThemeBuilderShared as ThemeBuilder } from '@components/theme-builder/ThemeBuilderShared';
import { getThemeParamDocs } from '@utils/server/getThemeParamDocs';

// Read here rather than in the builder: the descriptions come from the
// generated interface reference, which is 4MB and read from disk, so the
// builder gets the few kilobytes of it that describe theme params.
const paramDocs = getThemeParamDocs();
---

<Layout
    title="Theme Builder | AG Charts"
    description="Build a custom AG Charts theme in the browser: pick a palette, tune theme parameters against a live chart, and copy the theme into your application."
    showSearchBar={true}
    hideFooter
    noIndex
>
    <ThemeBuilder client:only="react" paramDocs={paramDocs} />
</Layout>
