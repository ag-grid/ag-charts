---
// cspell:ignore whats
import Layout from '@layouts/Layout.astro';
import styles from '@pages-styles/homepage.module.scss';
import { DISABLE_MARKDOWN_DOCS } from '@constants';
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';
import { getEntry, type CollectionEntry } from 'astro:content';
import { Icon } from '@ag-website-shared/components/icon/Icon';
import { urlWithPrefix } from '@utils/urlWithPrefix';
import { AutomatedIntegratedChartsWithPackages } from '@ag-website-shared/components/automated-examples/AutomatedIntegratedChartsWithPackages';
import { LandingPageSection } from '@ag-website-shared/components/landing-pages/LandingPageSection';
import { LandingPageFAQ } from '@ag-website-shared/components/landing-pages/LandingPageFAQ';
import { renderFAQAnswers } from '@ag-website-shared/components/landing-pages/renderFAQAnswers';
import { LandingPageFWSelector } from '@ag-website-shared/components/landing-pages/LandingPageFWSelector';
import ImageCarousel from '../components/homepage/components/hero/ImageCarousel';
import { parseVersion } from '@ag-website-shared/utils/parseVersion';
import { Version } from '@ag-website-shared/components/whats-new/components/Version';
import whatsNewData from '@ag-website-shared/content/whats-new/data.json';
import HomepageGalleryExamples from '@components/homepage/components/HomepageGalleryExamples.astro';
import HomepageDocsExample from '@components/homepage/components/HomepageDocsExample.astro';
import { FrameworkTextAnimation } from '@ag-website-shared/components/framework-text-animation/FrameworkTextAnimation';

const { blogPrefix } = whatsNewData['charts'];

// All Gallery Examples
const { data: FAQData } = (await getEntry('faqs', 'homepage')) as CollectionEntry<'faqs'>;
const renderedFAQData = renderFAQAnswers(FAQData);
const { data: versionsData } = (await getEntry('versions', 'ag-charts-versions')) as CollectionEntry<'versions'>;
const { data: homepageData } = (await getEntry('homepage', 'homepage')) as CollectionEntry<'homepage'>;

const { hero, sections } = homepageData;

const frameworksData = [
    {
        name: 'react',
        url: urlWithPrefix({
            framework: 'react',
            url: './quick-start',
        }),
    },
    {
        name: 'angular',
        url: urlWithPrefix({
            framework: 'angular',
            url: './quick-start',
        }),
    },
    {
        name: 'vue',
        url: urlWithPrefix({
            framework: 'vue',
            url: './quick-start',
        }),
    },
    {
        name: 'javascript',
        url: urlWithPrefix({
            framework: 'javascript',
            url: './quick-start',
        }),
    },
];

const mapExampleHeights = 360;

const markdownUrl = DISABLE_MARKDOWN_DOCS ? undefined : urlWithBaseUrl('/index.md');
---

<Layout
    title="JavaScript Charts | AG Charts"
    description="Create beautiful, high-performance JavaScript Charts quickly with AG Charts. Free forever; upgrade to enterprise for advanced features and dedicated support."
    markdownUrl={markdownUrl}
>
    <div class:list={[styles.container]}>
        <div class={styles.homepageHero}>
            <div class:list={[styles.heroInner, 'layout-max-width-small']}>
                <div class={styles.heroHeadings}>
                    <noscript>
                        <h1>{hero.heading}</h1>
                        <style>
                            .only-script {
                                display: none !important;
                            }
                        </style>
                    </noscript>

                    <h1 class="only-script">
                        <span class={styles.heroTopLine}>The Best&nbsp;<FrameworkTextAnimation client:load /></span>
                        <span>Charts in the World</span>
                    </h1>

                    <h2>{hero.subHeading}</h2>

                    <a id="view-gallery" href={urlWithBaseUrl(hero.cta.url)} class="button-secondary"
                        >{hero.cta.title} <Icon name="chevronRight" /></a
                    >
                </div>

                <ImageCarousel client:load />
            </div>
        </div>

        <div class={styles.homepageFrameworks}>
            <div class:list={[styles.frameworksInner, 'layout-max-width-small']}>
                <LandingPageFWSelector client:load data={frameworksData} isFullWidth />
            </div>
        </div>

        <LandingPageSection
            tag={sections.gallery.tag}
            heading={sections.gallery.heading}
            ctaTitle={sections.gallery.ctaTitle}
            ctaUrl={urlWithBaseUrl(sections.gallery.ctaUrl)}
            ctaId={sections.gallery.ctaId}
        >
            <HomepageGalleryExamples />
        </LandingPageSection>

        <LandingPageSection
            tag={sections.financial.tag}
            heading={sections.financial.heading}
            subHeading={sections.financial.subHeading}
            ctaTitle={sections.financial.ctaTitle}
            ctaUrl={urlWithBaseUrl(sections.financial.ctaUrl)}
            ctaId={sections.financial.ctaId}
        >
            <div>
                <HomepageDocsExample
                    options={{ exampleHeight: 700 }}
                    pageName="financial-charts"
                    exampleName="financial-charts-showcase"
                />
            </div>
        </LandingPageSection>

        <LandingPageSection
            tag={sections.maps.tag}
            heading={sections.maps.heading}
            subHeading={sections.maps.subHeading}
            ctaTitle={sections.maps.ctaTitle}
            ctaUrl={urlWithBaseUrl(sections.maps.ctaUrl)}
            ctaId={sections.maps.ctaId}
        >
            <div class={styles.cardContainer}>
                <div class={styles.card}>
                    <h4>{sections.maps.cards[0].heading}</h4>
                    <p>{sections.maps.cards[0].description}</p>
                    <HomepageDocsExample
                        pageName="map-shapes"
                        exampleName="multiple-series"
                        options={{ exampleHeight: mapExampleHeights }}
                    />
                </div>
                <div class={styles.card}>
                    <h4>{sections.maps.cards[1].heading}</h4>
                    <p>{sections.maps.cards[1].description}</p>
                    <HomepageDocsExample
                        pageName="map-lines"
                        exampleName="map-shapes-lines"
                        options={{ exampleHeight: mapExampleHeights }}
                    />
                </div>
                <div class={styles.card}>
                    <h4>{sections.maps.cards[2].heading}</h4>
                    <p>{sections.maps.cards[2].description}</p>
                    <HomepageDocsExample
                        pageName="map-markers"
                        exampleName="marker-size"
                        options={{ exampleHeight: mapExampleHeights }}
                    />
                </div>
            </div>
        </LandingPageSection>

        <LandingPageSection
            tag={sections.integrated.tag}
            heading={sections.integrated.heading}
            subHeadingHtml={sections.integrated.subHeadingHtml}
        >
            <AutomatedIntegratedChartsWithPackages client:visible visibilityThreshold={0.8} />
        </LandingPageSection>

        <LandingPageSection
            tag={sections.releases.tag}
            heading={sections.releases.heading}
            subHeading={sections.releases.subHeading}
            ctaTitle={sections.releases.ctaTitle}
            ctaUrl={urlWithBaseUrl(sections.releases.ctaUrl)}
            ctaId={sections.releases.ctaId}
        >
            <div class={styles.latestNewsVersions}>
                {
                    versionsData
                        .filter((versionInfo) => versionInfo.version.endsWith('.0')) // Exclude patch releases
                        .slice(0, 3)
                        .map((versionInfo, index) => {
                            if (versionInfo.highlights) {
                                const { major, minor } = parseVersion(versionInfo.version);
                                const blogUrl = `${minor ? `${blogPrefix}${major}-${minor}` : `${blogPrefix}${major}`}/`;
                                return (
                                    <Version
                                        client:load
                                        isLatest={index === 0}
                                        blogUrl={blogUrl}
                                        version={versionInfo.version}
                                        date={versionInfo.date}
                                        highlights={versionInfo.highlights}
                                        notesPath={versionInfo.notesPath}
                                    />
                                );
                            }
                        })
                }
            </div>
        </LandingPageSection>

        <LandingPageSection
            tag={sections.faqs.tag}
            heading={sections.faqs.heading}
            subHeading={sections.faqs.subHeading}
        >
            <LandingPageFAQ client:load FAQData={renderedFAQData} />
        </LandingPageSection>
    </div>
</Layout>

{
    /* Externalised to a 'self' script (config via data- attributes) so the site CSP
    can drop script-src 'unsafe-inline' — see public/scripts/site-header-scroll.js.
    Classic non-deferred script so document.currentScript resolves. */
}
<script
    is:inline
    src={urlWithBaseUrl('/scripts/site-header-scroll.js')}
    data-target-selector=".site-header"
    data-scrolled-class="header-scrolled"
    data-scroll-position="480"></script>
