---
// cspell:ignore whats
import Layout from '@layouts/Layout.astro';
import styles from '@pages-styles/homepage.module.scss';
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';
import { getEntry, type CollectionEntry } from 'astro:content';
import { Icon } from '@ag-website-shared/components/icon/Icon';
import { urlWithPrefix } from '@utils/urlWithPrefix';
import { AutomatedIntegratedChartsWithPackages } from '@ag-website-shared/components/automated-examples/AutomatedIntegratedChartsWithPackages';
import { LandingPageSection } from '@ag-website-shared/components/landing-pages/LandingPageSection';
import { LandingPageFAQ } from '@ag-website-shared/components/landing-pages/LandingPageFAQ';
import { LandingPageFWSelector } from '@ag-website-shared/components/landing-pages/LandingPageFWSelector';
import ImageCarousel from '../components/homepage/components/hero/ImageCarousel';
import { parseVersion } from '@ag-website-shared/utils/parseVersion';
import { Version } from '@ag-website-shared/components/whats-new/components/Version';
import whatsNewData from '@ag-website-shared/content/whats-new/data.json';
import HomepageGalleryExamples from '@components/homepage/components/HomepageGalleryExamples.astro';
import HomepageDocsExample from '@components/homepage/components/HomepageDocsExample.astro';
import { FrameworkTextAnimation } from '@ag-website-shared/components/framework-text-animation/FrameworkTextAnimation';

const { blogPrefix } = whatsNewData['charts'];

// All Gallery Examples
const { data: FAQData } = (await getEntry('faqs', 'homepage')) as CollectionEntry<'faqs'>;
const { data: versionsData } = (await getEntry('versions', 'ag-charts-versions')) as CollectionEntry<'versions'>;

const frameworksData = [
    {
        name: 'react',
        url: urlWithPrefix({
            framework: 'react',
            url: './quick-start',
        }),
    },
    {
        name: 'angular',
        url: urlWithPrefix({
            framework: 'angular',
            url: './quick-start',
        }),
    },
    {
        name: 'vue',
        url: urlWithPrefix({
            framework: 'vue',
            url: './quick-start',
        }),
    },
    {
        name: 'javascript',
        url: urlWithPrefix({
            framework: 'javascript',
            url: './quick-start',
        }),
    },
];

const mapExampleHeights = 360;
---

<Layout
    title="JavaScript Charts | AG Charts"
    description="Create beautiful, high-performance JavaScript Charts quickly with AG Charts. Free forever; upgrade to enterprise for advanced features and dedicated support."
>
    <div class:list={[styles.container]}>
        <div class={styles.homepageHero}>
            <div class:list={[styles.heroInner, 'layout-max-width-small']}>
                <div class={styles.heroHeadings}>
                    <noscript>
                        <h1>The Best JavaScript Charts in the World</h1>
                        <style>
                            .only-script {
                                display: none !important;
                            }
                        </style>
                    </noscript>

                    <h1 class="only-script">
                        <span class={styles.heroTopLine}>The Best&nbsp;<FrameworkTextAnimation client:load /></span>
                        <span>Charts in the World</span>
                    </h1>

                    <h2>The professional choice for developers building enterprise applications</h2>

                    <a
                        id="view-gallery"
                        href={urlWithBaseUrl(
                            '/gallery?utm_source=charts-homepage&utm_medium=hero-section&utm_campaign=homepage-cta'
                        )}
                        class="button-secondary">See the charts <Icon name="chevronRight" /></a
                    >
                </div>

                <ImageCarousel client:load />
            </div>
        </div>

        <div class={styles.homepageFrameworks}>
            <div class:list={[styles.frameworksInner, 'layout-max-width-small']}>
                <LandingPageFWSelector client:load data={frameworksData} isFullWidth />
            </div>
        </div>

        <LandingPageSection
            tag="AG Charts JavaScript Charting Library"
            heading="JavaScript Charts Designed for Every Use Case"
            ctaTitle="Get Started For Free"
            ctaUrl={urlWithBaseUrl(
                '/react/quick-start/?utm_source=charts-homepage&utm_medium=features-section&utm_campaign=homepage-cta'
            )}
            ctaId="get-started-for-free"
        >
            <HomepageGalleryExamples />
        </LandingPageSection>

        <LandingPageSection
            tag="JavaScript Financial Charts - Create Trading Views in Minutes"
            heading="Interactive Financial Charts for Trading and Analysis"
            subHeading="Build interactive financial charts featuring advanced annotations with minimal configuration - just provide your data. Use the toolbar in the example below to add annotations, change the chart type, and interact with the data in real-time."
            ctaTitle="View Financial Charts Features"
            ctaUrl={urlWithBaseUrl(
                '/react/financial-charts/?utm_source=charts-homepage&utm_medium=financial-charts-section&utm_campaign=homepage-cta'
            )}
            ctaId="financial-charts-cta"
        >
            <div>
                <HomepageDocsExample
                    options={{ exampleHeight: 700 }}
                    pageName="financial-charts"
                    exampleName="financial-charts-showcase"
                />
            </div>
        </LandingPageSection>

        <LandingPageSection
            tag="JavaScript Map Charts - Easily Visualise Geographical Data"
            heading="Customisable JavaScript Map Charts for Geographical Data Visualisation"
            subHeading="Visualise Geographical Areas, Overlay Routes & Connections, Add Markers & Points Of Interest."
            ctaTitle="View Map Charts Features"
            ctaUrl={urlWithBaseUrl(
                '/react/maps/?utm_source=charts-homepage&utm_medium=maps-section&utm_campaign=homepage-cta'
            )}
            ctaId="map-charts-cta"
        >
            <div class={styles.cardContainer}>
                <div class={styles.card}>
                    <h4>Geographic Areas</h4>
                    <p>
                        Visualise data representing geographic areas such as countries, using colours to denote distinct
                        series or the magnitude of the values.
                    </p>
                    <HomepageDocsExample
                        pageName="map-shapes"
                        exampleName="multiple-series"
                        options={{ exampleHeight: mapExampleHeights }}
                    />
                </div>
                <div class={styles.card}>
                    <h4>Routes & Connections</h4>
                    <p>
                        Draw geographic lines, such as roads or flight paths, with the ability to vary width and colour
                        to represent data values.
                    </p>
                    <HomepageDocsExample
                        pageName="map-lines"
                        exampleName="map-shapes-lines"
                        options={{ exampleHeight: mapExampleHeights }}
                    />
                </div>
                <div class={styles.card}>
                    <h4>Markers & POIs</h4>
                    <p>
                        Add markers data for geographic points, with the ability to vary the size to represent data
                        values.
                    </p>
                    <HomepageDocsExample
                        pageName="map-markers"
                        exampleName="marker-size"
                        options={{ exampleHeight: mapExampleHeights }}
                    />
                </div>
            </div>
        </LandingPageSection>

        <LandingPageSection
            tag="AG Grid Integrated JavaScript Charts"
            heading="AG Grid Integrated Charts, Powered by AG Charts"
            subHeadingHtml='AG Charts powers the <a href="https://www.ag-grid.com/react-data-grid/integrated-charts/">Integrated Charts</a> feature in <a href="https://www.ag-grid.com/">AG Grid</a> - our market leading data grid library which is used by 90% of the Fortune 500. Purchase an <a href="https://www.ag-grid.com/license-pricing">Enterprise Bundle License</a> to access all of the Enterprise features in both AG Grid and AG Charts.'
        >
            <AutomatedIntegratedChartsWithPackages client:visible visibilityThreshold={0.8} />
        </LandingPageSection>

        <LandingPageSection
            tag="Latest JavaScript Charting Releases from AG Charts"
            heading="Regular Releases, Updates, and Enhancements"
            subHeading="Browse the latest updates to AG Charts JavaScript Charting Library, including new features, series types, functionality and more."
            ctaTitle="See What's New"
            ctaUrl={urlWithBaseUrl(
                '/whats-new/?utm_source=charts-homepage&utm_medium=whats-new-section&utm_campaign=homepage-cta'
            )}
            ctaId="whats-new-cta"
        >
            <div class={styles.latestNewsVersions}>
                {
                    versionsData
                        .filter((versionInfo) => versionInfo.version.endsWith('.0')) // Exclude patch releases
                        .slice(0, 3)
                        .map((versionInfo, index) => {
                            if (versionInfo.highlights) {
                                const { major, minor } = parseVersion(versionInfo.version);
                                const blogUrl = `${minor ? `${blogPrefix}${major}-${minor}` : `${blogPrefix}${major}`}/`;
                                return (
                                    <Version
                                        client:load
                                        isLatest={index === 0}
                                        blogUrl={blogUrl}
                                        version={versionInfo.version}
                                        date={versionInfo.date}
                                        highlights={versionInfo.highlights}
                                        notesPath={versionInfo.notesPath}
                                    />
                                );
                            }
                        })
                }
            </div>
        </LandingPageSection>

        <LandingPageSection
            tag="JavaScript Charts Frequently Asked Questions"
            heading="FAQs"
            subHeading="Answers to common questions about AG Charts, and JavaScript Charting in general."
        >
            <LandingPageFAQ client:load FAQData={FAQData} framework={'react'} />
        </LandingPageSection>
    </div>
</Layout>

<script>
    import { initScrollClassListener } from '@ag-website-shared/utils/initScrollClassListener';

    initScrollClassListener({
        targetSelector: '.site-header',
        scrolledClass: 'header-scrolled',
        scrollPosition: 480,
    });
</script>
