---
/**
 * Vue Charts Landing Page
 *
 * Content is defined in: src/content/landing-pages/vue-charts.json
 */

import LandingPage from '@components/landing-pages/LandingPage.astro';
import { getEntry } from 'astro:content';

const contentEntry = await getEntry('landingPages', 'vue-charts');
const versionsEntry = await getEntry('versions', 'ag-charts-versions');

const content = contentEntry?.data;
const versions = versionsEntry?.data;
---

{content && <LandingPage content={content} versions={versions} />}
