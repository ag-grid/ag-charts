---
import Layout from '@layouts/Layout.astro';
import DemoPage from '@components/demo-examples/DemoPage.astro';
import { DEMO_PAGE_CONTENT } from '@components/demo-examples/demoPageContent';
import { DISABLE_MARKDOWN_DOCS } from '@constants';
import { urlWithBaseUrl } from '@utils/urlWithBaseUrl';

const content = DEMO_PAGE_CONTENT['procurement'];
const markdownUrl = DISABLE_MARKDOWN_DOCS ? undefined : urlWithBaseUrl('/examples-procurement.md');
---

<Layout title={content.metaTitle} description={content.metaDescription} showSearchBar={true} markdownUrl={markdownUrl}>
    <DemoPage currentId="procurement" />
</Layout>
