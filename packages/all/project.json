{
  "name": "all",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/all/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:noop",
      "inputs": [],
      "outputs": [],
      "dependsOn": ["^build"],
      "configurations": {
        "staging": {},
        "archive": {},
        "production": {}
      }
    },
    "lint": {
      "executor": "nx:noop",
      "inputs": [],
      "outputs": [],
      "dependsOn": ["^lint"],
      "configurations": {
        "fix": {}
      }
    },
    "test": {
      "executor": "nx:noop",
      "inputs": [],
      "outputs": [],
      "dependsOn": ["^test"],
      "configurations": {
        "update": {}
      }
    },
    "test:e2e": {
      "executor": "nx:noop",
      "inputs": [],
      "outputs": [],
      "dependsOn": ["^test:e2e"],
      "configurations": {
        "update": {}
      }
    },
    "test:package": {
      "executor": "nx:noop",
      "inputs": [],
      "outputs": [],
      "dependsOn": ["^test:package"],
      "configurations": {
        "update": {}
      }
    },
    "pack": {
      "executor": "nx:noop",
      "inputs": [],
      "outputs": [],
      "dependsOn": ["^pack"],
      "configurations": {
        "staging": {},
        "archive": {},
        "production": {}
      }
    },
    "pack:extract": {
      "executor": "nx:noop",
      "inputs": [],
      "outputs": [],
      "dependsOn": ["^pack:extract"],
      "configurations": {
        "staging": {},
        "archive": {},
        "production": {}
      }
    },
    "pack:verify": {
      "executor": "nx:noop",
      "inputs": [],
      "outputs": [],
      "dependsOn": ["^pack:verify"],
      "configurations": {
        "staging": {},
        "archive": {},
        "production": {}
      }
    },
    "generate": {
      "dependsOn": ["^generate-examples", "^generate-thumbnails"],
      "executor": "nx:noop",
      "inputs": [],
      "outputs": [],
      "cache": false,
      "configurations": {
        "staging": {},
        "archive": {},
        "production": {}
      }
    },
    "generate-examples": {
      "dependsOn": ["^generate-examples"],
      "executor": "nx:noop",
      "inputs": [],
      "outputs": [],
      "cache": false,
      "configurations": {
        "staging": {},
        "archive": {},
        "production": {}
      }
    },
    "generate-thumbnails": {
      "dependsOn": ["^generate-thumbnails"],
      "executor": "nx:noop",
      "inputs": [],
      "outputs": [],
      "cache": false,
      "configurations": {
        "staging": {},
        "archive": {},
        "production": {}
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build:types", "^build:package", "generate"],
      "inputs": [],
      "outputs": [],
      "options": {
        "parallel": true,
        "commands": [
          "NX_DAEMON=true yarn concurrently -n \"watch,astro\" --kill-others \"node external/ag-shared/scripts/watch/watch.js charts\" \"nx run ag-charts-website:dev\""
        ]
      }
    },
    "dev:lite": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build:types", "^build:package", "generate"],
      "inputs": [],
      "outputs": [],
      "options": {
        "parallel": true,
        "commands": [
          "NX_DAEMON=true yarn concurrently -n \"watch,astro\" --kill-others \"node external/ag-shared/scripts/watch/watch.js charts\" \"./tools/dev-server/lite.sh\""
        ]
      }
    },
    "dev:quick": {
      "executor": "nx:run-commands",
      "dependsOn": ["ag-charts-website-gallery_simple-bar_main.ts:generate-thumbnail"],
      "inputs": [],
      "outputs": [],
      "options": {
        "parallel": true,
        "commands": [
          "NX_DAEMON=true yarn concurrently -n \"watch,astro\" --kill-others \"node external/ag-shared/scripts/watch/watch.js charts\" \"nx run ag-charts-website:dev\""
        ]
      },
      "configurations": {
        "windows": {
          "commands": [
            {
              "command": "nx run ag-charts-website:dev --configuration watch"
            }
          ]
        }
      }
    },
    "format-check": {
      "command": "nx format:check --all",
      "cache": true,
      "inputs": ["{workspaceRoot}/**"],
      "outputs": []
    },
    "validate-examples": {
      "dependsOn": ["^validate-examples"],
      "cache": false,
      "inputs": [],
      "outputs": []
    },
    "blt": {
      "executor": "nx:noop",
      "dependsOn": [
        "^build",
        "generate-examples",
        "generate-thumbnails",
        "lint",
        "format",
        "test",
        "validate-examples"
      ],
      "inputs": [],
      "outputs": [],
      "cache": false
    },
    "blt:ci": {
      "executor": "nx:noop",
      "dependsOn": ["blt", "^test:e2e", "^test:package"],
      "inputs": [],
      "outputs": [],
      "cache": false
    },
    "clean": {
      "cache": false,
      "command": "./tools/clean.sh"
    },
    "nuke": {
      "cache": false,
      "command": "./tools/nuke.sh"
    },
    "benchmark": {
      "dependsOn": ["^benchmark"],
      "cache": false,
      "command": "node ./tools/benchmark/collate-reports.js"
    },
    "benchmark:report": {
      "cache": false,
      "command": "node ./tools/benchmark/compare-versions.js"
    },
    "benchmark:rebuild": {
      "dependsOn": ["ag-charts-website-benchmarks_summary_main.ts:generate-example"],
      "cache": false,
      "command": "./tools/benchmark/rebuild-version-benchmark.sh"
    },
    "generate-docs-example": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["nx run ag-charts-website-{args.page}_{args.example}_main.ts:generate-example --skip-nx-cache"]
      }
    },
    "generate-gallery-example": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["nx run ag-charts-website-gallery_{args.example}_main.ts:generate-example --skip-nx-cache"]
      }
    },
    "generate-gallery-thumbnail": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["nx run ag-charts-website-gallery_{args.example}_main.ts:generate-thumbnail --skip-nx-cache"]
      }
    },
    "ci:debug": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "./external/ag-shared/scripts/gha-debug",
        "command": "./runner.sh ag-charts",
        "parallel": false,
        "forwardAllArgs": true
      }
    },
    "snyk:test": {
      "command": "npx snyk test --yarn-workspaces --dev --strict-out-of-sync=false --severity-threshold=high --exclude=.nx,project.json,dist --remote-repo-url=https://github.com/ag-grid/ag-charts",
      "options": {
        "cwd": "{workspaceRoot}"
      }
    },
    "snyk:code": {
      "command": "npx snyk code test",
      "options": {
        "cwd": "{workspaceRoot}"
      }
    },
    "snyk:ignore": {
      "command": "node ./external/ag-shared/scripts/snyk/getSnykIgnore.mjs",
      "options": {
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "implicitDependencies": [
    "ag-charts-core",
    "ag-charts-community",
    "ag-charts-enterprise",
    "ag-charts-community-examples",
    "ag-charts-website",
    "ag-charts-angular",
    "ag-charts-locale",
    "ag-charts-react",
    "ag-charts-types",
    "ag-charts-vue3",
    "ag-charts-task-autogen",
    "ag-charts-generate-code-reference-files",
    "ag-charts-generate-chart-thumbnail",
    "ag-charts-generate-example-files",
    "ag-charts-eslint-rules",
    "ag-charts-test",
    "angular-package-tests",
    "react-package-tests",
    "vue-package-tests"
  ],
  "tags": []
}
