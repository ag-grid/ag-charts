{
  "name": "ag-charts-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:noop",
      "dependsOn": ["build:types", "build:package"],
      "inputs": [],
      "outputs": [],
      "configurations": {
        "watch": {},
        "production": {}
      }
    },
    "build:types": {},
    "build:test": {},
    "build:package": {},
    "lint:eslint": {},
    "lint:circular": {},
    "lint:depcruise": {},
    "lint": {
      "executor": "nx:noop",
      "dependsOn": ["lint:eslint", "lint:circular", "lint:depcruise"],
      "configurations": {
        "fix": {}
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}", "{workspaceRoot}/reports/ag-charts-core.xml"],
      "options": {
        "jestConfig": "{projectRoot}/jest.config.ts",
        "passWithNoTests": false
      },
      "configurations": {
        "watch": {
          "watch": true
        },
        "update": {
          "updateSnapshot": true
        }
      },
      "dependsOn": ["build:test"]
    }
  },
  "tags": ["no-batching", "no-sharding"]
}
