    "jsdom": "^24.0.0",
    "skia-canvas": "^3.0.8"
  },
  "devDependencies": {
    "ag-charts-community": "13.1.0-beta.20260309",
    "ag-charts-enterprise": "13.1.0-beta.20260309",
