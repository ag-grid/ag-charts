{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "financial": {
            "projectType": "application",
            "root": "",
            "sourceRoot": "src",
            "prefix": "fin",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "outputPath": { "base": "dist", "browser": "" },
                        "index": "src/index.html",
                        "browser": "src/main.ts",
                        "polyfills": ["zone.js"],
                        "tsConfig": "tsconfig.app.json",
                        "styles": ["src/styles.css", "src/financial.css"],
                        "define": { "import.meta.env.VITE_DEMO_DETERMINISTIC": "undefined" },
                        "outputHashing": "all",
                        "budgets": []
                    },
                    "configurations": {
                        "production": {
                            "optimization": {
                                "scripts": true,
                                "styles": { "minify": true, "inlineCritical": false },
                                "fonts": true
                            },
                            "sourceMap": false
                        },
                        "development": { "optimization": false, "sourceMap": true, "extractLicenses": false }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "configurations": {
                        "production": { "buildTarget": "financial:build:production" },
                        "development": { "buildTarget": "financial:build:development" }
                    },
                    "defaultConfiguration": "development"
                }
            }
        }
    }
}
