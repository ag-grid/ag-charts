{
  "name": "ag-charts-demos-seeds",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/ag-charts-demos/seeds",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "typecheck"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/*/*/dist"],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "for seed in */react; do echo \"== $seed\" && vite build \"$seed\" || exit 1; done"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": [],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "for seed in */react; do echo \"== $seed\" && tsc --noEmit -p \"$seed/tsconfig.json\" || exit 1; done"
      }
    }
  },
  "implicitDependencies": ["ag-charts-community", "ag-charts-enterprise", "ag-charts-react"]
}
