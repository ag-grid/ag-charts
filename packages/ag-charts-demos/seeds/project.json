{
  "name": "ag-charts-demos-seeds",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/ag-charts-demos/seeds",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "typecheck", "build-vue", "build-typescript"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/*/*/dist"],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "for seed in */react; do echo \"== $seed\" && vite build \"$seed\" || exit 1; done"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": [],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "for seed in */react; do echo \"== $seed\" && tsc --noEmit -p \"$seed/tsconfig.json\" || exit 1; done"
      }
    },
    "build-vue": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "typecheck-vue"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/*/vue/dist"],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "for seed in */vue; do echo \"== $seed\" && vite build \"$seed\" || exit 1; done"
      }
    },
    "typecheck-vue": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": [],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "for seed in */vue; do echo \"== $seed\" && vue-tsc --noEmit -p \"$seed/tsconfig.json\" || exit 1; done"
      }
    },
    "build-typescript": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "typecheck-typescript"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/*/typescript/dist"],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "for seed in */typescript; do echo \"== $seed\" && vite build \"$seed\" || exit 1; done"
      }
    },
    "typecheck-typescript": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": [],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "for seed in */typescript; do echo \"== $seed\" && tsc --noEmit -p \"$seed/tsconfig.json\" || exit 1; done"
      }
    }
  },
  "implicitDependencies": ["ag-charts-community", "ag-charts-enterprise", "ag-charts-react", "ag-charts-vue3"]
}
