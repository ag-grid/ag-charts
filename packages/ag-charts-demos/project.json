{
  "name": "ag-charts-demos",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/ag-charts-demos/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "typecheck"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "DEMOS_BASE_PATH=./ vite build"
      }
    },
    "build:watch": {
      "executor": "nx:run-commands",
      "inputs": ["production"],
      "outputs": ["{projectRoot}/dist"],
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "DEMOS_BASE_PATH=./ vite build"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build:types"],
      "inputs": ["production", "^production"],
      "outputs": [],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["tsc --noEmit -p tsconfig.json"]
      }
    },
    "dev": {
      "dependsOn": ["^build"],
      "command": "vite",
      "options": { "cwd": "{projectRoot}" }
    },
    "preview": {
      "dependsOn": ["build"],
      "command": "vite preview",
      "options": { "cwd": "{projectRoot}" }
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "inputs": ["{projectRoot}/playwright.config.ts", "{projectRoot}/e2e/**", "production"],
      "outputs": [],
      "cache": false,
      "parallelism": false,
      "command": "playwright test",
      "options": { "cwd": "{projectRoot}" }
    },
    "lint:eslint": {},
    "lint": {
      "executor": "nx:noop",
      "dependsOn": ["lint:eslint"]
    }
  },
  "implicitDependencies": ["ag-charts-community", "ag-charts-enterprise", "ag-charts-react"]
}
