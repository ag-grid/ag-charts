{
    "permissions": {
        "allow": [
            "Bash(find:*)",
            "Bash(ls:*)",
            "Bash(rg:*)",
            "Bash(grep:*)",
            "Bash(mkdir:*)",
            "Bash(touch:*)",
            "Bash(mv:reports/*)",
            "Bash(nx lint:*)",
            "Bash(nx show projects:*)",
            "Bash(nx build:*)",
            "Bash(nx generate-examples:*)",
            "Bash(gh pr list:*)",
            "Bash(gh pr view:*)",
            "Bash(gh pr diff:*)",
            "Bash(gh pr checks:*)",
            "Bash(git fetch:*)",
            "WebFetch(domain:github.com)"
        ],
        "deny": [],
        "enabledMcpjsonServers": ["mcp-atlassian", "mcp-github"]
    },
    "includeCoAuthoredBy": false,
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|MultiEdit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jq -r '.tool_input.file_path' | { read file_path; if echo \"$file_path\" | grep -q '\\.ts$'; then yarn prettier --write \"$file_path\"; fi; }"
                    }
                ]
            }
        ]
    }
}
